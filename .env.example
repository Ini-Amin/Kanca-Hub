# Auto-FreeCF / KancaHub — environment template
#
# Copy to a local file OUTSIDE the repo, or to ~/.config/auto-freecf/.env:
#   cp .env.example ~/.config/auto-freecf/.env
#   chmod 600 ~/.config/auto-freecf/.env
#
# Never commit a filled-in copy. Everything here is optional — each tool only
# reads the keys it needs, and most have working defaults.

# ── Temp-mail / mail adapter ────────────────────────────────────────────────
# Required by mail-adapter/adapter.py (it refuses to start without a key).
TMK_KEY=
API_BASE=https://YOUR-PROJECT.supabase.co/functions/v1/temp-mail-api

# ── Cloudflare ──────────────────────────────────────────────────────────────
# Optional: reuse an existing token instead of running the signup flow.
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=

# ── 9Router (local model router) ────────────────────────────────────────────
NINE_ROUTER_HOME=
NINE_ROUTER_KEY=
NINE_ROUTER_BASE=http://localhost:20128

# ── Captcha solving ─────────────────────────────────────────────────────────
CAPSOLVER_API_KEY=

# ── Bridges (local HTTP endpoints) ──────────────────────────────────────────
# Shared bearer token for the bridge services. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=
BRIDGE_API_KEYS=
CODEBUDDY_AUTH_TOKEN=
QODER_PERSONAL_ACCESS_TOKEN=
GROK2API_BASE=

# ── Notifications ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Research / bounty tooling ───────────────────────────────────────────────
FIRECRAWL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
BOUNTY_R9_KEY=
BOUNTY_R9_BASE=

# ── ADB (android device farm) ───────────────────────────────────────────────
# Comma-separated emails, or point at a file with one email per line.
CF_ADB_ACCOUNTS=
CF_ADB_ACCOUNTS_FILE=

# ── Test fixtures ───────────────────────────────────────────────────────────
# Path to a local, git-ignored email:password file for tests/test_batch.sh.
ACCOUNTS_FILE=
