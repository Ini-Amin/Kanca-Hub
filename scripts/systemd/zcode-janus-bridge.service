[Unit]
Description=ZCode bridge for Janus (OpenAI-compatible, :8788, dedicated egress)
# Janus's own bridge: same accounts/keys/JWTs as the main bridge, but its
# upstream goes through a DEDICATED egress (VeePN pool exit) instead of the
# shared LightVela WARP tunnel. z.ai's WAF throttles the shared tunnel's
# volume (~283 req/hour -> Alibaba 405, then 3012); Janus's traffic must not
# compete with (or be blocked by) everyone else's burn.
#
# Egress comes from EnvironmentFile (regenerate with proxy_pool if it dies):
#   python3 -c "import sys; sys.path.insert(0,'scripts'); import proxy_pool; ..."
# Independent of 9Router (no PartOf): Janus restarts it as needed.

[Service]
WorkingDirectory=%h/Auto-FreeCF
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/auto-freecf/janus_egress.env
ExecStart=%h/.local/share/auto-freecf/venv/bin/python scripts/zcode.py serve --port 8788
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
