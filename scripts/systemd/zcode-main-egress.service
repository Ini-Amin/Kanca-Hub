[Unit]
Description=ZCode Rotating Residential Egress Relay (:25346)
After=network.target

[Service]
WorkingDirectory=%h/Auto-FreeCF
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/amen/.local/share/auto-freecf/venv/bin/python /home/amen/Auto-FreeCF/scripts/zcode_egress_rotator.py --port 25346
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
