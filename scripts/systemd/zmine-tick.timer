[Unit]
Description=Run the ZMINE autopilot pass (farm + session renew + tasks)

[Timer]
# zmine.si rate-limits registration to a handful per hour, so a pass every 2 h
# (with jitter) grows the farm gently and still renews every session well inside
# its 24 h life. Persistent=true so a missed pass runs once after a resume.
OnCalendar=*-*-* 00/2:17
Persistent=true
RandomizedDelaySec=1200

[Install]
WantedBy=timers.target
