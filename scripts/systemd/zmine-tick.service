[Unit]
Description=ZMINE autopilot: gently grow the referral farm + renew sessions + daily tasks
# Zero human-in-the-loop. Each pass tops the referred-account count up toward the
# 25 target AND renews the 24 h mining session + answers up to 12 tasks/day for
# every stored account. It never hammers: registrations are spaced by a shared
# gate and a 429 parks the whole thing for the site's retryAfter window.

[Service]
Type=oneshot
WorkingDirectory=%h/Auto-FreeCF
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 %h/Auto-FreeCF/scripts/zmine.py autopilot --target 25 --ref RCFZ9GA7
TimeoutStartSec=5400
Nice=10
