[Unit]
Description=Janus egress relay: plaintext CONNECT on :25345 chaining into the VPN pool (TLS)
# stdlib urllib (the ZCode bridge) cannot speak HTTPS-proxy CONNECT, but the
# VPN pool is TLS-only. This sidecar accepts plaintext CONNECT on localhost
# and re-issues it inside TLS to the pool exit. Upstream URL (with creds)
# comes from the same EnvironmentFile as the Janus bridge; creds never touch
# health endpoints or logs (the bridge only ever sees 127.0.0.1:25345).

[Service]
WorkingDirectory=%h/Auto-FreeCF
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/auto-freecf/janus_egress.env
ExecStart=/bin/sh -c 'exec %h/.local/share/auto-freecf/venv/bin/python %h/Auto-FreeCF/scripts/egress.py --relay 25345 --upstream "$JANUS_UPSTREAM"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
