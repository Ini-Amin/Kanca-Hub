{
  "name": "auto-freecf",
  "version": "4.3.1",
  "description": "Cloudflare AI Account Manager — Login & Signup from scratch, all from one CLI",
  "bin": {
    "moycf": "cli.js"
  },
  "files": [
    "cli.js",
    "postinstall.js",
    "browser_bot.py",
    "web_ui.py",
    "terminal_ui.py",
    "requirements.txt",
    "deploy-browserfarm.sh",
    "assets/",
    "auto_freecf/",
    "signup_from_scratch/main.py",
    "signup_from_scratch/requirements.txt",
    "signup_from_scratch/README.md",
    "signup_from_scratch/config.example.json",
    "signup_from_scratch/proxies.txt.example",
    "signup_from_scratch/src/",
    "mail-adapter/adapter.py",
    "mail-adapter/requirements.txt",
    "mail-adapter/config.example.json",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!**/config.json",
    "!**/proxies.txt",
    "!**/results*.json",
    "!**/token_map.json",
    "!**/.env"
  ],
  "scripts": {
    "prepack": "node scripts/check-npm-contents.js"
  },
  "keywords": [
    "cloudflare",
    "workers-ai",
    "automation",
    "browser",
    "token",
    "signup",
    "turnstile"
  ],
  "author": "mocasus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mocasus/Auto-FreeCF.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
