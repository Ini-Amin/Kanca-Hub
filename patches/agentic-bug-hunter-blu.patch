+        log("err", f"No live URLs for {domain}. Run recon first.")
+        return False
+    child_env = os.environ.copy()
+    if _AUTH_SESSION is not None:
+        _AUTH_SESSION.export_to_env(child_env)
+    cmd = [sys.executable, os.path.join(TOOLS_DIR, "cors_scanner.py"),
+           "-l", url_file]
+    try:
+        proc = subprocess.Popen(cmd, shell=False, cwd=BASE_DIR, env=child_env)
+        proc.wait(timeout=600)
+        return proc.returncode == 0
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        return False
+
+
+def _live_url_file(domain: str, cap: int = 50) -> str | None:
+    """Return a path to a bounded list of live URLs for `domain`, or None.
+
+    Capped because every consumer here fans out one HTTP request per line:
+    an uncapped live/urls.txt on a big scope is thousands of requests, which
+    is both a budget problem (it alone outlasts --time) and an unfocused one.
+    The capped copy is written next to recon output, not in it, so it can
+    never be mistaken for recon data.
+    """
+    recon_dir = os.path.join(RECON_DIR, domain)
+    src = os.path.join(recon_dir, "live", "urls.txt")
+    if not os.path.isfile(src) or os.path.getsize(src) == 0:
+        return None
+    try:
+        with open(src, encoding="utf-8", errors="replace") as fh:
+            urls = []
+            seen = set()
+            for line in fh:
+                u = line.strip().split()[0] if line.strip() else ""
+                if not u.startswith("http") or u in seen:
+                    continue
+                seen.add(u)
+                urls.append(u)
+                if len(urls) >= cap:
+                    break
+    except OSError:
+        return None
+    if not urls:
+        return None
+    bounded = os.path.join(recon_dir, "live", f"urls_top{cap}.txt")
+    try:
+        Path(bounded).write_text("\n".join(urls) + "\n")
+    except OSError:
+        return None
+    return bounded
+
+
+def _run_script(script: str, args: list[str], timeout: int = 600) -> bool:
+    """Run a tools/ script with argv (never a shell string) and auth env."""
+    child_env = os.environ.copy()
+    if _AUTH_SESSION is not None:
+        _AUTH_SESSION.export_to_env(child_env)
+    try:
+        proc = subprocess.Popen(["bash", os.path.join(TOOLS_DIR, script), *args],
+                                shell=False, cwd=BASE_DIR, env=child_env)
+        proc.wait(timeout=timeout)
+        return proc.returncode == 0
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        return False
+    except OSError:
+        return False
+
+
+def _run_py(script: str, args: list[str], timeout: int = 600) -> bool:
+    child_env = os.environ.copy()
+    if _AUTH_SESSION is not None:
+        _AUTH_SESSION.export_to_env(child_env)
+    try:
+        proc = subprocess.Popen([sys.executable, os.path.join(TOOLS_DIR, script), *args],
+                                shell=False, cwd=BASE_DIR, env=child_env)
+        proc.wait(timeout=timeout)
+        return proc.returncode == 0
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        return False
+    except OSError:
+        return False
+
+
+def run_crlf_scan(domain):
+    """CRLF / response-splitting probe on the top live URLs."""
+    url_file = _live_url_file(domain)
+    if not url_file:
+        log("err", f"No live URLs for {domain}. Run recon first.")
+        return False
+    log("info", f"CRLF scan on bounded URL list {url_file}")
+    return _run_py("crlf_scanner.py", ["-l", url_file])
+
+
+def run_403_bypass(domain):
+    """Probe admin/forbidden endpoints for 401/403 bypass."""
+    url_file = _live_url_file(domain)
+    if not url_file:
+        log("err", f"No live URLs for {domain}. Run recon first.")
+        return False
+    log("info", "403/401 bypass probe on bounded URL list")
+    return _run_script("bypass_403.sh", ["-l", url_file], timeout=900)
+
+
+def run_takeover_scan(domain):
+    """Check every discovered subdomain for dangling-takeover candidates."""
+    recon_dir = os.path.join(RECON_DIR, domain)
+    if not os.path.isdir(recon_dir):
+        log("err", f"No recon data found for {domain}. Run recon first.")
+        return False
+    log("info", "Subdomain takeover check")
+    return _run_script("takeover_scanner.sh", ["--recon", recon_dir], timeout=900)
+
+
+def run_nosqli_scan(domain):
+    """NoSQL injection probe against any login endpoint found in recon.
+
+    Needs a login URL: without one there is no JSON auth body to inject into,
+    so this returns a clean no-data result rather than guessing a path and
+    POSTing payloads at an unrelated endpoint.
+    """
+    recon_dir = os.path.join(RECON_DIR, domain)
+    candidates: list[str] = []
+    for rel in ("urls/logins.txt", "urls/auth.txt", "urls/all.txt", "all-urls.txt"):
+        path = os.path.join(recon_dir, rel)
+        if not os.path.isfile(path):
+            continue
+        try:
+            with open(path, encoding="utf-8", errors="replace") as fh:
+                for line in fh:
+                    u = line.strip().split()[0] if line.strip() else ""
+                    if re.search(r"/(login|signin|sign-in|auth|session|token)([/?]|$)", u, re.I):
+                        if u.startswith("http") and u not in candidates:
+                            candidates.append(u)
+        except OSError:
+            continue
+        if candidates:
+            break
+    if not candidates:
+        log("info", f"No login endpoint found in recon for {domain} — nothing to probe.")
+        return False
+    target = candidates[0]
+    log("info", f"NoSQLi login probe: {target}")
+    return _run_py("nosqli_scanner.py", ["--login", target], timeout=300)
+
+
+def run_jwt_audit(domain):
+    """Extract any JWT-shaped tokens captured during recon and analyse them.
+
+    Offline only: jwt_scanner.py --analyze just decodes and audits header
+    claims/alg/key-id, so no request leaves the box. Nothing to do when recon
+    captured no token — a clean no-data result, not a failed run.
+    """
+    recon_dir = os.path.join(RECON_DIR, domain)
+    if not os.path.isdir(recon_dir):
+        log("err", f"No recon data found for {domain}. Run recon first.")
+        return False
+    jwt_re = re.compile(r"eyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}")
+    found: set[str] = set()
+    for root, _dirs, files in os.walk(recon_dir):
+        if "/sessions/" in root + "/":
+            continue          # our own traces, never target data
+        for fn in files:
+            if not fn.endswith((".txt", ".json", ".jsonl")):
+                continue
+            try:
+                with open(os.path.join(root, fn), "r", errors="ignore") as fh:
+                    for _ in range(200):
+                        chunk = fh.read(65536)
+                        if not chunk:
+                            break
+                        for m in jwt_re.findall(chunk):
+                            found.add(m)
+                        if len(found) >= 5:
+                            break
+            except OSError:
+                continue
+        if len(found) >= 5:
+            break
+    if not found:
+        log("info", f"No JWT captured for {domain} — nothing to audit.")
+        return False
+    log("info", f"Auditing {len(found)} JWT(s) offline...")
+    child_env = os.environ.copy()
+    if _AUTH_SESSION is not None:
+        _AUTH_SESSION.export_to_env(child_env)
+    ok = False
+    for tok in sorted(found):
+        cmd = [sys.executable, os.path.join(TOOLS_DIR, "jwt_scanner.py"),
+               tok, "--analyze"]
+        try:
+            proc = subprocess.run(cmd, shell=False, cwd=BASE_DIR, env=child_env,
+                                  timeout=120, capture_output=True, text=True)
+            if proc.returncode == 0:
+                ok = True
+        except (subprocess.TimeoutExpired, OSError):
+            continue
+    return ok
+
+
 def generate_reports(domain):
     """Generate reports for findings."""
     log("warn", "report_generator.py has been removed. Use /report in Claude Code to generate reports.")
