+#!/usr/bin/env python3
+"""Tool integrity. Run after ANY change to TOOLS, dispatch(), or tools/hunt.py.
+
+Background: the agent once advertised 17 tools while only 6 had
+implementations. Picking a missing one raised AttributeError inside
+dispatch(), which returned the error without bumping step_count, so the model
+retried it forever and the hunt ended as "Steps executed: 0". These checks
+make that failure mode impossible to reintroduce silently.
+
+Standalone (no pytest):  python3 tests/test_tool_integrity.py
+"""
+import sys
+from pathlib import Path
+
+BUGHUNTER = Path(__file__).resolve().parent.parent / "bughunter"
+sys.path.insert(0, str(BUGHUNTER))
+
+import agent  # noqa: E402
+from tools import hunt  # noqa: E402
+
+# agent._h() loads tools/hunt.py a SECOND time under the module name "hunt",
+# so it is a different object than the import above. Always patch through
+# agent._h() or the dispatcher never sees the patch.
+h = agent._h()
+
+fails = 0
+
+
+def check(cond, label):
+    global fails
+    print(("  ok   " if cond else "  FAIL ") + label)
+    if not cond:
+        fails += 1
+
+
+def main():
+    global fails
+    fails = 0
+    print("1. every advertised run_* tool has an implementation")
+    run_tools = [t["function"]["name"] for t in agent.TOOLS
+                 if t["function"]["name"].startswith("run_")]
+    print("     advertised:", ", ".join(run_tools))
+    for name in run_tools:
+        check(hasattr(hunt, name) and callable(getattr(hunt, name)),
+              f"{name} exists in tools/hunt.py")
+
+    print("2. no advertised tool references a function that was never written")
+    for name in run_tools:
+        check(not name.startswith("run_") or hasattr(hunt, name), f"{name} resolvable")
+
+    print("3. NETWORK_TOOLS and TOOL_METHODS only cover real tools")
+    names = agent.TOOL_NAMES
+    for net in agent.ToolDispatcher.NETWORK_TOOLS:
+        check(net in names, f"network tool {net} is advertised")
+        check(net in agent.ToolDispatcher.TOOL_METHODS,
+              f"network tool {net} has a declared HTTP method")
+    for method in agent.ToolDispatcher.TOOL_METHODS:
+        check(method in names, f"method entry {method} is advertised")
+    # Offline tools may carry a method entry without being scope-gated; what must
+    # never happen is the reverse. A network tool with no declared method would be
+    # assumed GET and could slip past AutopilotGuard's method policy.
+    for net in agent.ToolDispatcher.NETWORK_TOOLS:
+        check(net in agent.ToolDispatcher.TOOL_METHODS,
+              f"{net} has a declared method for the guard's policy check")
+
+    print("4. PHASE_FLAG_TOOLS points at tools that exist")
+    for flag, tool in agent.PHASE_FLAG_TOOLS.items():
+        check(tool in names, f"phase flag '{flag}' -> {tool} advertised")
+
+    print("5. an unadvertised tool is refused, not executed")
+    mem = agent.HuntMemory(str(Path(__file__).parent / "_tmp_integrity_session.json"))
+    d = agent.ToolDispatcher("example.com", mem, time_budget_hours=2.0)
+    out = d.dispatch("run_cms_exploit", {})
+    check("Unknown tool" in out, "dropped tool name refused at dispatch")
+
+    print("6. an exception still counts as a step (never a silent 0-step run)")
+    # run_jwt_audit is offline (not in NETWORK_TOOLS), so no scope gate runs
+    # upstream — it lands in the try/except the same way every real failure does.
+    real = h.run_jwt_audit
+    def boom(domain):
+        raise RuntimeError("simulated tool failure")
+    h.run_jwt_audit = boom
+    try:
+        before = mem.step_count
+        out = d.dispatch("run_jwt_audit", {})
+        check("raised exception" in out, "exception surfaced to the model")
+        check(mem.step_count == before + 1,
+              f"step_count incremented ({before} -> {mem.step_count})")
+    finally:
+        h.run_jwt_audit = real
+
+    print("7. a working tool also counts as a step")
+    real_hunt = h.run_secret_hunt
+    h.run_secret_hunt = lambda domain: True
+    try:
+        before = mem.step_count
+        d.dispatch("run_secret_hunt", {})
+        check(mem.step_count == before + 1, "step_count incremented on success")
+    finally:
+        h.run_secret_hunt = real_hunt
+
+    Path(str(Path(__file__).parent / "_tmp_integrity_session.json")).unlink(
+        missing_ok=True)
+    print("RESULT:", "ALL PASS" if fails == 0 else "%d FAILURES" % fails)
+    return fails
+
+
+def test_tool_integrity():
+    """pytest entry point — same checks as the standalone run above."""
+    assert main() == 0
+
+
+if __name__ == "__main__":
+    sys.exit(1 if main() else 0)
