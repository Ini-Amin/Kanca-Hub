+def _decode_completion(text: str) -> dict:
+    """Decode a chat-completion body that may be SSE or carry an SSE trailer.
+
+    9router answers a NON-streaming request with `content-type:
+    text/event-stream` and a body that looks like:
+
+        data: {"id":..., "choices":[{"message":{...}}]}
+        data: [DONE]
+
+    `r.json()` raises `JSONDecodeError: Expecting value: line 1 column 1`,
+    which is easy to mistake for a malformed model reply — and because the
+    caller catches broadly, the symptom is an EMPTY string from a model that
+    answered correctly. Handled three ways, in order of cheapness:
+
+      1. plain JSON (a well-behaved gateway);
+      2. JSON with an appended `data: [DONE]` trailer (decode first value);
+      3. full SSE stream — concatenate the `delta.content` fragments, which is
+         what a streamed completion actually is.
+    """
+    text = (text or "").strip()
+    if not text:
+        raise RuntimeError("empty response body")
+
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        pass
+
+    if text.startswith("data:"):
+        content_parts: list[str] = []
+        last_obj: dict | None = None
+        for line in text.splitlines():
+            line = line.strip()
+            if not line.startswith("data:"):
+                continue
+            chunk = line[5:].strip()
+            if not chunk or chunk == "[DONE]":
+                continue
+            try:
+                obj = json.loads(chunk)
+            except json.JSONDecodeError:
+                continue
+            last_obj = obj
+            for ch in obj.get("choices") or []:
+                delta = ch.get("delta") or {}
+                if delta.get("content"):
+                    content_parts.append(delta["content"])
+                # Some gateways send the final message instead of a delta.
+                msg = ch.get("message") or {}
+                if msg.get("content"):
+                    content_parts.append(msg["content"])
+        if content_parts or last_obj is not None:
+            merged = dict(last_obj or {})
+            merged["choices"] = [{"message": {"content": "".join(content_parts)}}]
+            return merged
+        raise RuntimeError("SSE response carried no content chunks")
+
+    # JSON with a trailing SSE marker appended to the document.
+    try:
+        return json.JSONDecoder().raw_decode(text)[0]
+    except json.JSONDecodeError as exc:
+        raise RuntimeError(f"unparseable completion body: {exc}") from exc
+
+
