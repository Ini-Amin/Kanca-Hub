+# ── OpenAI-compatible chat adapter (9router, vLLM, LM Studio, ...) ─────────────
+#
+# The ReAct loop was written against the Ollama Python client, so it raised
+# "Ollama Python package not installed" on any box that does not run a local
+# Ollama — including ours, where every model lives behind 9router on :20128.
+# The tool schemas in TOOLS are already plain OpenAI function-calling JSON, so
+# the only thing missing was a client that speaks that dialect.
+#
+# This adapter returns the same {"message": {"content", "tool_calls"}} shape the
+# loop already consumes, which keeps the change contained to construction.
+class OpenAICompatClient:
+    """Minimal Ollama-shaped client over an OpenAI-compatible /chat/completions."""
+
+    def __init__(self, base_url: str, api_key: str, timeout: int = 180):
+        import requests
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self._http = requests.Session()
+        self._http.headers.update({
+            "Authorization": f"Bearer {api_key}",
+            "Content-Type": "application/json",
+        })
+
+    def list(self):
+        """Return an object with `.models` of `.model` names, like ollama.list()."""
+        class _M:
+            def __init__(self, name): self.model = name
+        class _L:
+            def __init__(self, names): self.models = [_M(n) for n in names]
+        try:
+            r = self._http.get(f"{self.base_url}/models", timeout=30)
+            r.raise_for_status()
+            payload = _decode_json(r.text)
+            return _L([m.get("id", "") for m in payload.get("data", []) if m.get("id")])
+        except Exception:
+            return _L([])
+
+    def chat(self, *, model, messages, tools=None, options=None):
+        """Ollama-shaped chat with BOUNTY_MODEL_FALLBACKS failover."""
+        raw_fb = os.environ.get(
+            "BOUNTY_MODEL_FALLBACKS",
+            "Zcode/GLM-5.3,THK/deepseek-v4.1-flash:free",
+        )
+        chain = [model] + [m.strip() for m in raw_fb.split(",") if m.strip() and m.strip() != model]
+        last_err = None
+        for attempt, m in enumerate(chain):
+            try:
+                body = {"model": m, "messages": messages, "temperature": 0.1}
+                if options:
+                    if options.get("num_predict"):
+                        body["max_tokens"] = options["num_predict"]
+                    if options.get("temperature") is not None:
+                        body["temperature"] = options["temperature"]
+                if tools:
+                    body["tools"] = tools
+                    body["tool_choice"] = "auto"
+                r = self._http.post(f"{self.base_url}/chat/completions",
+                                    data=json.dumps(body), timeout=self.timeout)
+                r.raise_for_status()
+                payload = _decode_json(r.text)
+                if "choices" not in payload and isinstance(payload.get("data"), dict):
+                    payload = payload["data"]
+                if "choices" not in payload:
+                    raise RuntimeError(
+                        "no 'choices' in response (keys: %s)" % sorted(payload)[:10])
+                msg = payload["choices"][0].get("message") or {}
+                if attempt:
+                    print(f"[Agent] failed over to {m}", file=sys.stderr, flush=True)
+                return {
+                    "message": {
+                        "content": msg.get("content") or "",
+                        "tool_calls": msg.get("tool_calls") or [],
+                    }
+                }
+            except Exception as e:
+                last_err = e
+                continue
+        raise last_err or RuntimeError("all models failed")
+
+
+def _decode_json(text: str) -> dict:
+    """Parse a JSON body that may have SSE frames appended.
+
+    9router answers a NON-streaming request with `content-type: text/event-stream`
+    and appends the SSE terminator to the JSON document:
+
+        {"id":"chatcmpl-...","choices":[...]}data: [DONE]
+
+    `json.loads` then raises "Extra data", which is easy to mistake for a
+    malformed model reply. Decode the first value and ignore the trailer.
+    """
+    text = (text or "").strip()
+    if not text:
+        raise RuntimeError("empty response body")
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        return json.JSONDecoder().raw_decode(text)[0]
+
