+++ b/tests/test_drost_bridge.py
@@ -0,0 +1,282 @@
+#!/usr/bin/env python3
+"""run_drost_tool: the drost-ai MCP bridge and the three restrictions on it.
+
+The agent is unattended AND it reads attacker-controlled pages, so anything
+the model parses from a target is a place an attacker can put instructions.
+These tests exist to pin down the three restrictions that follow from that:
+
+  * bash/execute are never reachable, not even by calling call_drost_mcp
+    directly,
+  * tools that actively attack are refused, not merely labelled,
+  * a host buried in an *argument* is scope-checked, not just the --target.
+
+Everything runs against a fake session — no container, no network.
+
+Run after ANY change to call_drost_mcp / _run_drost_tool / _DrostSession:
+    python3 tests/test_drost_bridge.py        (or pytest tests/test_drost_bridge.py)
+"""
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+# agent.py lives in bughunter/, not at the repo root -- insert that directory
+# (the same one tests/conftest.py and test_surface_rank.py use).
+BUGHUNTER = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "bughunter"))
+if BUGHUNTER not in sys.path:
+    sys.path.insert(0, BUGHUNTER)
+
+import agent
+from agent import (DROST_ACTIVE, DROST_DENIED, HuntMemory, ToolDispatcher,
+                   call_drost_mcp)
+from tools.scope_checker import ScopeChecker
+
+fails = 0
+
+
+def check(cond, label):
+    global fails
+    if not cond:
+        fails += 1
+    print("%-4s %s" % ("OK" if cond else "FAIL", label))
+
+
+def tool_schema(name, props):
+    return {name: {"name": name, "inputSchema": {"properties": props}}}
+
+
+# Catalog entries mirroring what `drost-mcp --catalog-json` and tools/list
+# actually report: exec-style tools take engagement_id + arguments, field-style
+# tools take their own fields and reject an unexpected engagement_id with a
+# pydantic validation error.
+EXEC_SCHEMA = tool_schema("drost_nmap", {
+    "engagement_id": {"type": "string"},
+    "arguments": {"items": {"type": "string"}, "type": "array"},
+})
+FIELD_SCHEMA = tool_schema("drost_cve_lookup", {"cve_id": {"type": "string"}})
+CATALOG = {}
+CATALOG.update(EXEC_SCHEMA)
+CATALOG.update(FIELD_SCHEMA)
+CATALOG.update(tool_schema("drost_ffuf", {
+    "engagement_id": {"type": "string"},
+    "arguments": {"items": {"type": "string"}, "type": "array"},
+}))
+CATALOG.update(tool_schema("drost_bash", {
+    "engagement_id": {"type": "string"},
+    "arguments": {"items": {"type": "string"}, "type": "array"},
+}))
+CATALOG.update(tool_schema("drost_sqlmap", {
+    "engagement_id": {"type": "string"},
+    "arguments": {"items": {"type": "string"}, "type": "array"},
+}))
+
+
+class FakeSession:
+    """Stands in for _DrostSession: records what was called, returns canned text."""
+
+    def __init__(self, catalog=None, replies=None, handshake_ok=True, timeout=1):
+        self.catalog = catalog if catalog is not None else CATALOG
+        self.replies = replies or {}
+        self.handshake_ok = handshake_ok
+        self.calls = []
+        self.closed = False
+        self.engagements = []
+
+    def handshake(self):
+        return self.handshake_ok
+
+    def tools_list(self):
+        return dict(self.catalog)
+
+    def call(self, name, arguments):
+        self.calls.append((name, arguments))
+        if name == "drost_engagement_create":
+            eid = "eng_20261018_%d" % (len(self.engagements) + 1)
+            self.engagements.append((name, arguments))
+            return True, json.dumps({"engagement_id": eid})
+        return self.replies.get(name, (True, "canned output"))
+
+    def close(self):
+        self.closed = True
+
+
+def with_fake(fake, fn):
+    """Swap in `fake` as the session factory.
+
+    _DrostSession is called as a constructor (sess = _DrostSession(timeout)),
+    so the seam has to accept that positional timeout and hand back the fake —
+    pointing it straight at an instance makes every real call die on
+    `instance(timeout)` before it reaches the fake.
+    """
+    real = agent._DrostSession
+    agent._DrostSession = lambda *a, **k: fake
+    try:
+        return fn()
+    finally:
+        agent._DrostSession = real
+
+
+def dispatcher(tmp):
+    # ScopeChecker anchors exactly: `example.com` matches only the apex, so a
+    # subdomain needs the wildcard the way a real Bugcrowd brief spells it.
+    return ToolDispatcher("example.com", HuntMemory(str(Path(tmp) / "s.json")),
+                          scope_checker=ScopeChecker(
+                              domains=["example.com", "*.example.com"]))
+
+
+def main() -> int:
+    global fails
+    fails = 0
+    agent._DROST_ENGAGEMENTS.clear()
+
+    # ---------- policy constants ----------
+    print("1. bash/execute are denied, attack tools are approval-gated")
+    check("drost_bash" in DROST_DENIED and "drost_execute" in DROST_DENIED,
+          "bash and execute are in DROST_DENIED")
+    for t in ("drost_sqlmap", "drost_dalfox", "drost_xsser", "drost_zap"):
+        check(t in DROST_ACTIVE, f"{t} is approval-gated")
+    check(not (DROST_DENIED & DROST_ACTIVE), "denied and active sets do not overlap")
+
+    # ---------- the dispatcher's own refusals ----------
+    with tempfile.TemporaryDirectory() as tmp:
+        d = dispatcher(tmp)
+
+        print("2. denied and approval-gated tools are refused before any container call")
+        fake = FakeSession()
+        for t in sorted(DROST_DENIED):
+            out = with_fake(fake, lambda t=t: d.dispatch(
+                "run_drost_tool", {"tool_name": t, "args_json": '{"arguments": ["x"]}'}))
+            check(out.startswith("DENIED"), f"{t} refused ({out[:40]}...)")
+            check("do NOT call" in out, f"{t} refusal is terminal, not retryable")
+        for t in sorted(DROST_ACTIVE):
+            out = with_fake(fake, lambda t=t: d.dispatch(
+                "run_drost_tool", {"tool_name": t, "args_json": '{"arguments": ["x"]}'}))
+            check(out.startswith("REQUIRES APPROVAL"), f"{t} requires approval ({out[:40]}...)")
+            check("do NOT call" in out, f"{t} refusal is terminal")
+        check(fake.calls == [], "container was never invoked for any refused call")
+
+        print("3. malformed args_json is rejected")
+        out = d.dispatch("run_drost_tool", {"tool_name": "drost_nmap", "args_json": "{oops"})
+        check(out.startswith("BLOCKED"), f"bad JSON refused ({out[:50]})")
+        out = d.dispatch("run_drost_tool", {"tool_name": "drost_nmap",
+                                            "args_json": '["-sV", "h"]'})
+        check("JSON object" in out, f"non-object refused ({out[:60]})")
+        out = d.dispatch("run_drost_tool", {"args_json": "{}"})
+        check("needs tool_name" in out, f"missing tool_name refused ({out[:50]})")
+
+        print("4. a host buried in an ARGUMENT is scope-checked")
+        bad = d._drost_scope_violations({"arguments": ["-u", "https://evil.test/a"]})
+        check(bad == ["evil.test"], f"out-of-scope host detected ({bad})")
+        ok = d._drost_scope_violations({"arguments": ["-u", "https://app.example.com/a"]})
+        check(ok == [], "in-scope host passes")
+        ok = d._drost_scope_violations({"cve_id": "CVE-2021-44228"})
+        check(ok == [], "no host-shaped value is not a violation")
+        bad = d._drost_scope_violations({"arguments": ["-u", "10.9.8.7"]})
+        check(bad == ["10.9.8.7"], f"bare IP is checked too ({bad})")
+
+        print("5. a filename is not mistaken for a host")
+        for arg in ("moment.js", "report.pdf", "style.css", "data.json"):
+            v = d._drost_scope_violations({"arguments": [arg]})
+            check(v == [], f"{arg} does not block the call ({v})")
+        # ...but a real host with a file-looking name still gets checked
+        v = d._drost_scope_violations({"arguments": ["https://evil.test/app.js"]})
+        check(v == ["evil.test"], f"a real out-of-scope host is still caught ({v})")
+
+        print("6. the scope refusal happens before the container is touched")
+        fake = FakeSession()
+        out = with_fake(fake, lambda: d.dispatch(
+            "run_drost_tool",
+            {"tool_name": "drost_ffuf", "args_json": '{"arguments": ["-u", "https://evil.test/"]}'})
+        )
+        check(out.startswith("BLOCKED by scope guard"), f"refused at dispatch ({out[:45]})")
+        check(fake.calls == [], "container never invoked for an out-of-scope call")
+
+        print("7. happy path: engagement created and passed through")
+        agent._DROST_ENGAGEMENTS.clear()
+        fake = FakeSession()
+        out = with_fake(fake, lambda: d.dispatch(
+            "run_drost_tool",
+            {"tool_name": "drost_nmap",
+             "args_json": '{"arguments": ["-Pn", "-p", "443", "app.example.com"]}'}))
+        check("drost drost_nmap: OK" in out, f"tool ran ({out[:50]})")
+        check(len(fake.calls) == 2, "engagement_create then the tool")
+        check(bool(fake.calls) and fake.calls[0][0] == "drost_engagement_create",
+              "engagement created first")
+        tool_args = fake.calls[1][1] if len(fake.calls) > 1 else {}
+        check(str(tool_args.get("engagement_id", "")).startswith("eng_"),
+              f"server-generated engagement id passed ({tool_args.get('engagement_id')})")
+        check(tool_args.get("arguments") == ["-Pn", "-p", "443", "app.example.com"],
+              "argv tokens passed through verbatim")
+        check(fake.closed, "session torn down afterwards")
+
+        print("8. the engagement is reused, not recreated per call")
+        fake2 = FakeSession()
+        with_fake(fake2, lambda: d.dispatch(
+            "run_drost_tool", {"tool_name": "drost_nmap",
+                               "args_json": '{"arguments": ["-Pn", "app.example.com"]}'}))
+        create_count = sum(1 for n, _ in fake2.calls if n == "drost_engagement_create")
+        check(create_count == 0, f"no second engagement_create ({create_count})")
+
+        print("9. tools with their own field schema are NOT given an engagement_id")
+        fake = FakeSession()
+        out = with_fake(fake, lambda: d.dispatch(
+            "run_drost_tool",
+            {"tool_name": "drost_cve_lookup", "args_json": '{"cve_id": "CVE-2021-44228"}'}))
+        check("drost drost_cve_lookup: OK" in out, f"field tool ran ({out[:50]})")
+        check(len(fake.calls) == 1, "no engagement_create for a field-style tool")
+        check("engagement_id" not in (fake.calls[0][1] if fake.calls else {}),
+              "engagement_id not injected into a schema that rejects it")
+
+        print("10. an unknown tool name is reported, not crashed on")
+        fake = FakeSession()
+        out = with_fake(fake, lambda: d.dispatch(
+            "run_drost_tool", {"tool_name": "drost_nope", "args_json": "{}"}))
+        check("no such tool" in out, f"unknown name reported ({out[:50]})")
+        check("drost_nmap" in out, "error names a real tool as an example")
+        check(fake.calls == [], "container never invoked for an unknown tool")
+
+    # ---------- call_drost_mcp's own safety net ----------
+    print("11. the bridge refuses denied tools even when called directly")
+    agent._DROST_ENGAGEMENTS.clear()
+    fake = FakeSession()
+    out = with_fake(fake, lambda: call_drost_mcp("drost_bash", {"arguments": ["cat /etc/passwd"]}))
+    check(out.startswith("DENIED"), f"direct call also denied ({out[:40]})")
+    check(fake.calls == [], "container never invoked")
+
+    print("12. transport failures are observations, not crashes")
+    class DeadSession(FakeSession):
+        def handshake(self):
+            return False
+    out = with_fake(DeadSession(), lambda: call_drost_mcp("drost_nmap", {"arguments": ["x"]}))
+    check("handshake failed" in out, f"handshake failure reported ({out[:60]})")
+
+    class NoList(FakeSession):
+        def tools_list(self):
+            return {}
+    out = with_fake(NoList(), lambda: call_drost_mcp("drost_nmap", {"arguments": ["x"]}))
+    check("no tools" in out, f"empty catalog reported ({out[:60]})")
+
+    class Boom(FakeSession):
+        def handshake(self):
+            raise RuntimeError("container gone")
+    out = with_fake(Boom(), lambda: call_drost_mcp("drost_nmap", {"arguments": ["x"]}))
+    check("bridge error" in out and "container gone" in out,
+          f"exception surfaces as text ({out[:70]})")
+
+    print("13. output is truncated so a firehose cannot fill the context")
+    fake = FakeSession(replies={"drost_nmap": (True, "x" * 40000)})
+    out = with_fake(fake, lambda: call_drost_mcp("drost_nmap", {"arguments": ["x"]}))
+    check(len(out) < 9000, f"long output truncated ({len(out)} chars)")
+    check("truncated" in out, "truncation is stated, not silent")
+
+    print("RESULT: %s" % ("ALL PASS" if fails == 0 else "%d FAILURES" % fails))
+    return fails
+
+
+def test_drost_bridge():
+    assert main() == 0
+
+
+if __name__ == "__main__":
+    sys.exit(1 if main() else 0)
