+class OpenAICompatClient:
+    """Minimal Ollama-shaped client over an OpenAI-compatible /chat/completions.
+
+    The ReAct loop only ever calls `.list()` and `.chat(model=, messages=,
+    tools=, options=)`, so this returns the same shape and the loop stays
+    unaware of which backend it is talking to.
+
+    WHY THIS EXISTS: the loop was written against the Ollama Python package and
+    refuses to start without it. On blu there is no Ollama — every model lives
+    behind 9router on :20128 — so every hunt died at startup with
+    "Ollama Python package not installed".
+    """
+
+    def __init__(self, base_url: str, api_key: str, timeout: int = 180):
+        import requests
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self._http = requests.Session()
+        self._http.headers.update({
+            "Authorization": f"Bearer {api_key}",
+            "Content-Type": "application/json",
+        })
+
+    def list(self):
+        """Return an object with `.models` of `.model` names, like ollama.list()."""
+        class _M:
+            def __init__(self, name): self.model = name
+        class _L:
+            def __init__(self, names): self.models = [_M(n) for n in names]
+        try:
+            r = self._http.get(f"{self.base_url}/models", timeout=30)
+            r.raise_for_status()
+            payload = _decode_json(r.text)
+            return _L([m.get("id", "") for m in payload.get("data", []) if m.get("id")])
+        except Exception:
+            # A failed model listing must not abort the hunt: the caller only
+            # uses it to validate an explicitly requested model, and the model
+            # may well work even when /models is slow or blocked.
+            return _L([])
+
+    def chat(self, *, model, messages, tools=None, options=None):
+        """Ollama-shaped chat with BOUNTY_MODEL_FALLBACKS failover.
+
+        Failover is per-ATTEMPT, not per-hunt: one spent or retired model costs
+        one HTTP error, not the whole session. The chain comes from the env so
+        the same code runs against different gateways without edits.
+        """
+        raw_fb = os.environ.get(
+            "BOUNTY_MODEL_FALLBACKS",
+            "Zcode/GLM-5.3,THK/deepseek-v4.1-flash:free",
+        )
+        chain = [model] + [m.strip() for m in raw_fb.split(",")
+                           if m.strip() and m.strip() != model]
+        last_err = None
+        for attempt, m in enumerate(chain):
+            try:
+                body = {"model": m, "messages": messages, "temperature": 0.1}
+                if options:
+                    if options.get("num_predict"):
+                        body["max_tokens"] = options["num_predict"]
+                    if options.get("temperature") is not None:
+                        body["temperature"] = options["temperature"]
+                if tools:
+                    body["tools"] = tools
+                    body["tool_choice"] = "auto"
+                r = self._http.post(f"{self.base_url}/chat/completions",
+                                    data=json.dumps(body), timeout=self.timeout)
+                r.raise_for_status()
+                payload = _decode_json(r.text)
+                if "choices" not in payload and isinstance(payload.get("data"), dict):
+                    payload = payload["data"]
+                if "choices" not in payload:
+                    raise RuntimeError(
+                        "no 'choices' in response (keys: %s)" % sorted(payload)[:10])
+                msg = payload["choices"][0].get("message") or {}
+                if attempt:
+                    print(f"[Agent] failed over to {m}", file=sys.stderr, flush=True)
+                return {
+                    "message": {
+                        "content": msg.get("content") or "",
+                        "tool_calls": msg.get("tool_calls") or [],
+                    }
+                }
+            except Exception as e:  # noqa: BLE001 - any failure means "try next"
+                last_err = e
+                continue
+        raise last_err or RuntimeError("all models failed")
+
+
+def _decode_json(text: str) -> dict:
+    """Parse a completion body that may be SSE, or JSON with an SSE trailer.
+
+    9router answers a NON-streaming request with `content-type:
+    text/event-stream` and a body of `data: {...}` lines. `json.loads` raises
+    "Expecting value: line 1 column 1", which reads like a malformed model
+    reply — and because callers catch broadly, the symptom is an empty string
+    from a model that answered correctly.
+
+    Three shapes handled: plain JSON; JSON with an appended `data: [DONE]`;
+    and a full SSE stream (delta.content fragments are concatenated).
+    """
+    text = (text or "").strip()
+    if not text:
+        raise RuntimeError("empty response body")
+
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        pass
+
+    if text.startswith("data:"):
+        parts: list[str] = []
+        last: dict | None = None
+        for line in text.splitlines():
+            line = line.strip()
+            if not line.startswith("data:"):
+                continue
+            chunk = line[5:].strip()
+            if not chunk or chunk == "[DONE]":
+                continue
+            try:
+                obj = json.loads(chunk)
+            except json.JSONDecodeError:
+                continue
+            last = obj
+            for ch in obj.get("choices") or []:
+                delta = ch.get("delta") or {}
+                if delta.get("content"):
+                    parts.append(delta["content"])
+                msg = ch.get("message") or {}
+                if msg.get("content"):
+                    parts.append(msg["content"])
+        if parts or last is not None:
+            merged = dict(last or {})
+            merged["choices"] = [{"message": {"content": "".join(parts)}}]
+            return merged
+        raise RuntimeError("SSE response carried no content chunks")
+
+    return json.JSONDecoder().raw_decode(text)[0]
+
+
