+    def _tool_slice(self, fraction: float) -> int:
+        """Seconds a long subprocess may run: `fraction` of the time left.
+
+        A tool that can outlive the budget is a tool that ends the session.
+        run_recon's own cap is 3600s against a 540s budget, so one call could
+        consume everything and the loop would stop having done nothing but
+        recon. The floor keeps a slice usable when little remains — partial
+        recon output is still written and still useful.
+
+        NOTE: these attribute names belong to ToolDispatcher (`_time_budget_hours`,
+        `_start_time`), not to ReActAgent (`time_budget_secs`, `time_start`).
+        Using the agent's names here raises AttributeError on every dispatch.
+        """
+        left = self._time_budget_hours * 3600 - (time.time() - self._start_time)
+        return max(60, int(left * max(0.05, min(1.0, fraction))))
