@@ -0,0 +1,416 @@
+#!/usr/bin/env python3
+"""cve_match.py — exact version-range matching against cve_research.db.
+
+WHY THIS IS A SEPARATE MODULE FROM cve_intel.py
+-----------------------------------------------
+`cve_intel.py` searches *descriptions* for a product name. That is the best you
+can do with the legacy `cve.db`, which threw away the vulnerable-configuration
+data. It is also why it needed heuristics (compound-name detection, "subject"
+ranking, third-party filtering): matching prose is guesswork.
+
+`cve_research.db` (workspace/Research Bug) keeps `cve_cpe`: 2.7M NVD
+vulnerable-configuration rows, 258k of which carry real version ranges
+(`v_start_incl` .. `v_end_excl`). With that, "Apache 2.4.49" is a set-membership
+question, not a text-similarity question:
+
+    CVE-2021-41773  apache:http_server  2.4.49          (exact version)
+    CVE-2021-42013  apache:http_server  2.4.49, 2.4.50  (exact versions)
+    CVE-2017-3167   apache:http_server  2.2.0..2.2.33, 2.4.0..2.4.26
+
+So the two data sources answer different questions and must not be blended:
+cve_research.db answers "is this observed version inside a published vulnerable
+range", cve.db answers "does any advisory mention this product". The first is
+evidence; the second is a reading list. cve_intel.py labels them differently
+(`range-match` vs `description-match`) so the agent can tell.
+
+VERSION SEMANTICS
+-----------------
+NVD version strings are not semver. Real values in the DB include `2.4.49`,
+`0.6.1516`, `1.0.0-beta.36`, `12.0`, `*`, and `-`. The comparator below splits
+on non-alphanumeric boundaries and compares numerically where both sides are
+numeric, which orders `2.4.9 < 2.4.10` correctly — the single most common way a
+naive string comparison produces a wrong answer.
+"""
+from __future__ import annotations
+
+import re
+import sqlite3
+from pathlib import Path
+
+# httpx/tech-detect product name -> NVD (vendor, product). Only the entries that
+# genuinely differ; everything else is normalised and looked up directly.
+# `f5|nginx` is the one that surprises people: NVD files nginx under F5, so a
+# `product='nginx'` query returns 2 rows while `vendor='f5' AND product='nginx'`
+# returns 703.
+ALIASES: dict[str, tuple[str, str]] = {
+    "apache http server": ("apache", "http_server"),
+    "apache": ("apache", "http_server"),
+    "httpd": ("apache", "http_server"),
+    "nginx": ("f5", "nginx"),
+    "next.js": ("vercel", "next.js"),
+    "nextjs": ("vercel", "next.js"),
+    "node.js": ("nodejs", "node.js"),
+    "nodejs": ("nodejs", "node.js"),
+    "spring framework": ("vmware", "spring_framework"),
+    "spring boot": ("vmware", "spring_framework"),
+    "spring": ("vmware", "spring_framework"),
+    "struts": ("apache", "struts"),
+    "tomcat": ("apache", "tomcat"),
+    "log4j": ("apache", "log4j"),
+    "iis": ("microsoft", "internet_information_services"),
+    "internet information services": ("microsoft", "internet_information_services"),
+    "envoy": ("envoyproxy", "envoy"),
+    "jquery": ("jquery", "jquery"),
+    "jenkins": ("jenkins", "jenkins"),
+    "gitlab": ("gitlab", "gitlab"),
+    "wordpress": ("wordpress", "wordpress"),
+    "drupal": ("drupal", "drupal"),
+    "grafana": ("grafana", "grafana"),
+    "haproxy": ("haproxy", "haproxy"),
+    "php": ("php", "php"),
+    "express": ("expressjs", "express"),
+    "vue": ("vuejs", "vue"),
+    "react": ("facebook", "react"),
+    "angular": ("google", "angular"),
+    "bootstrap": ("getbootstrap", "bootstrap"),
+    "lodash": ("lodash", "lodash"),
+    "moment": ("momentjs", "moment"),
+    "django": ("djangoproject", "django"),
+    "flask": ("palletsprojects", "flask"),
+    "rails": ("rubyonrails", "rails"),
+    "laravel": ("laravel", "laravel"),
+    "symfony": ("sensiolabs", "symfony"),
+    "redis": ("redis", "redis"),
+    "postgresql": ("postgresql", "postgresql"),
+    "mysql": ("oracle", "mysql"),
+    "mongodb": ("mongodb", "mongodb"),
+    "elasticsearch": ("elastic", "elasticsearch"),
+    "kibana": ("elastic", "kibana"),
+    "rabbitmq": ("vmware", "rabbitmq"),
+    "keycloak": ("redhat", "keycloak"),
+    "jira": ("atlassian", "jira"),
+    "confluence": ("atlassian", "confluence"),
+    "sonarqube": ("sonarsource", "sonarqube"),
+    "grafana": ("grafana", "grafana"),
+    "varnish": ("varnish-cache", "varnish"),
+    "squid": ("squid-cache", "squid"),
+    "lighttpd": ("lighttpd", "lighttpd"),
+    "caddy": ("caddyserver", "caddy"),
+    "traefik": ("traefik", "traefik"),
+    "jetty": ("eclipse", "jetty"),
+    "wildfly": ("redhat", "wildfly"),
+    "jboss": ("redhat", "jboss_enterprise_application_platform"),
+    "weblogic": ("oracle", "weblogic_server"),
+    "websphere": ("ibm", "websphere_application_server"),
+    "gunicorn": ("gunicorn", "gunicorn"),
+    "uvicorn": ("encode", "uvicorn"),
+    "fastapi": ("tiangolo", "fastapi"),
+    "ghost": ("ghost", "ghost"),
+    "magento": ("adobe", "magento"),
+    "joomla": ("joomla", "joomla!"),
+    "typo3": ("typo3", "typo3"),
+    "minio": ("minio", "minio"),
+    "consul": ("hashicorp", "consul"),
+    "vault": ("hashicorp", "vault"),
+    "nexus": ("sonatype", "nexus_repository_manager"),
+    "artifactory": ("jfrog", "artifactory"),
+}
+
+_SEP = re.compile(r"[._\-+~]")
+_NUM = re.compile(r"^(\d+)(.*)$")
+
+
+def _norm(s: str) -> str:
+    # Spaces are KEPT: "apache http server" and "spring framework" are the
+    # real product names, and stripping spaces turned them into
+    # "apachehttpserver" / "springframework", which match nothing. Collapse
+    # runs of whitespace rather than deleting it.
+    return re.sub(r"\s+", " ", (s or "").lower()).strip()
+
+
+def version_key(v: str) -> tuple:
+    """Comparable key for an NVD version string.
+
+    Splits on the separators NVD actually uses, then compares each token
+    numerically when possible. `2.4.9` vs `2.4.10` is the case that matters:
+    string comparison puts "10" before "9" and silently reports a vulnerable
+    host as patched.
+
+    A pre-release suffix sorts BELOW the release it qualifies (`1.0.0-beta` <
+    `1.0.0`), matching NVD's own semantics — a beta is inside a range whose
+    upper bound is the release.
+    """
+    v = (v or "").strip().lower()
+    if v in ("", "*", "-", "any"):
+        return (0,)
+    out: list = []
+    for tok in _SEP.split(v):
+        if not tok:
+            continue
+        m = _NUM.match(tok)
+        if m:
+            out.append((2, int(m.group(1))))
+            rest = m.group(2)
+            if rest:
+                # "1a", "2b": a letter suffix ranks below the bare number.
+                out.append((0, rest))
+        else:
+            out.append((1, tok))
+    return tuple(out) if out else (0,)
+
+
+def _cmp(a: str, b: str) -> int:
+    ka, kb = version_key(a), version_key(b)
+    n = max(len(ka), len(kb))
+    # Rank order inside a key: numbers (2) > prerelease/word tags (1).
+    # Padding a missing component with (2, 0) therefore means "a zero release
+    # component": "1.0" == "1.0.0", and both sort ABOVE "1.0.0-beta" whose next
+    # element is (1, "beta"). Padding with a rank above 2 made "1.0" > "1.0.0".
+    ka = ka + ((2, 0),) * (n - len(ka))
+    kb = kb + ((2, 0),) * (n - len(kb))
+    return (ka > kb) - (ka < kb)
+
+
+def in_range(version: str, row: dict) -> tuple[bool, str]:
+    """Is `version` inside this CPE row's vulnerable configuration?
+
+    Returns (match, reason) so the agent can see WHY a row matched instead of
+    trusting a bare boolean. Exact-version rows and range rows are both handled;
+    a row with neither (bare `*`) is NOT a match, because "any version" rows are
+    almost always platform/CVE-namespace rows rather than version evidence.
+    """
+    exact = (row.get("version") or "").strip()
+    si, se = (row.get("v_start_incl") or "").strip(), (row.get("v_start_excl") or "").strip()
+    ei, ee = (row.get("v_end_incl") or "").strip(), (row.get("v_end_excl") or "").strip()
+
+    if exact and exact not in ("*", "-", ""):
+        return (_cmp(version, exact) == 0,
+                f"exact version {exact}")
+    if not (si or se or ei or ee):
+        return (False, "no version constraint (bare wildcard)")
+
+    if si and _cmp(version, si) < 0:
+        return (False, f"below start {si}")
+    if se and _cmp(version, se) <= 0:
+        return (False, f"at/below excluded start {se}")
+    if ei and _cmp(version, ei) > 0:
+        return (False, f"above end {ei}")
+    if ee and _cmp(version, ee) >= 0:
+        return (False, f"at/above excluded end {ee}")
+
+    if si and ei:
+        return (True, f"in range {si}..{ei}")
+    if si:
+        return (True, f">= {si} (below {ee})" if ee else f">= {si}")
+    if se:
+        return (True, f"> {se} (below {ee})" if ee else f"> {se}")
+    if ei:
+        return (True, f"<= {ei}")
+    if ee:
+        return (True, f"< {ee}")
+    return (True, "range match")
+
+
+def resolve_product(product: str, con: sqlite3.Connection | None = None) -> tuple[str, str] | None:
+    """Map a tech-detect product name to (vendor, product) in cve_cpe."""
+    p = _norm(product)
+    if not p:
+        return None
+    if p in ALIASES:
+        return ALIASES[p]
+    # Try the literal normalised name as a product, preferring the vendor that
+    # owns the most CVEs for it (that is the real upstream, not a fork).
+    if con is not None:
+        try:
+            row = con.execute(
+                "SELECT vendor, product, COUNT(*) c FROM cve_cpe "
+                "WHERE product = ? GROUP BY 1,2 ORDER BY c DESC LIMIT 1", (p,)).fetchone()
+            if row:
+                return (row[0], row[1])
+        except sqlite3.Error:
+            pass
+    return None
+
+
+def open_db(path: Path | str) -> sqlite3.Connection | None:
+    p = Path(path)
+    if not p.is_file():
+        return None
+    try:
+        con = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
+        con.execute("SELECT 1 FROM cve_cpe LIMIT 1")
+        return con
+    except sqlite3.Error:
+        return None
+
+
+def match_version(con: sqlite3.Connection, vendor: str, product: str,
+                  version: str, min_cvss: float = 7.0, since: int = 2015,
+                  limit: int = 25) -> list[dict]:
+    """Every CVE whose published range contains `version` for this product."""
+    sql = """
+        SELECT c.cve_id, c.vendor, c.product, c.version,
+               c.v_start_incl, c.v_start_excl, c.v_end_incl, c.v_end_excl,
+               s.cvss31_score, s.cvss31_severity, s.primary_cwe, s.pillar_id,
+               s.pillar_name, s.kev, s.has_exploit_ref, s.pub_year, s.status,
+               s.cvss31_pr, s.cvss31_ui, s.cvss31_ac, s.cvss31_av
+          FROM cve_cpe c
+          JOIN cve_summary s ON s.id = c.cve_id
+         WHERE c.vendor = ? AND c.product = ? AND c.part = 'a'
+           AND s.pub_year >= ? AND (s.cvss31_score IS NULL OR s.cvss31_score >= ?)
+    """
+    try:
+        rows = con.execute(sql, (vendor, product, since, min_cvss)).fetchall()
+    except sqlite3.Error:
+        return []
+
+    hits, seen = [], set()
+    for r in rows:
+        (cve, ven, prod, exact, si, se, ei, ee, score, sev, cwe, pillar, pname,
+         kev, xref, year, status, pr, ui, ac, av) = r
+        if cve in seen:
+            continue
+        ok, why = in_range(version, {
+            "version": exact, "v_start_incl": si, "v_start_excl": se,
+            "v_end_incl": ei, "v_end_excl": ee})
+        if not ok:
+            continue
+        seen.add(cve)
+        risk = exploit_risk({
+            "cvss31_pr": pr, "cvss31_ui": ui, "cvss31_ac": ac, "cvss31_av": av,
+            "primary_cwe": cwe, "vendor": ven,
+            "kev": kev, "has_exploit_ref": xref,
+        })
+        hits.append({
+            "id": cve,
+            "cvss": score,
+            "severity": sev,
+            "year": year,
+            "status": status,
+            "cwe": cwe,
+            "pillar": pname,
+            "kev": bool(kev),
+            "exploit_ref": bool(xref),
+            "risk_pct": risk["pct"],
+            "risk_tier": risk["tier"],
+            "risk_reasons": risk["reasons"],
+            "match": why,
+            "source": "cve_research.db",
+            "version_match": "range",
+        })
+    # Empirical risk first, then KEV, then exploit refs, then CVSS. The risk
+    # score already folds KEV/exploit-ref into the probability, so this is
+    # ordering by likelihood-of-exploitation rather than by severity number —
+    # the research measured that CVSS>=9.0 misses 64% of actually-exploited CVEs.
+    hits.sort(key=lambda h: (not h["kev"], -(h.get("risk_pct") or 0),
+                             -(h["cvss"] or 0)))
+    return hits[:limit]
+
+
+def patterns(con: sqlite3.Connection, vendor: str, product: str,
+             since: int = 2017, min_cvss: float = 7.0, top: int = 6) -> list[dict]:
+    """CWE distribution for this product's high-severity CVEs.
+
+    Uses the View-1000 pillar rollup the research DB already computed, which is
+    more useful than raw CWE ids for deciding what to test: "Improper
+    Neutralization" tells you to fuzz input handling, whereas CWE-79 alone
+    tells you one specific outcome.
+    """
+    sql = """
+        SELECT s.primary_cwe, s.pillar_id, s.pillar_name, COUNT(*) c,
+               SUM(s.kev) kev_n, SUM(s.has_exploit_ref) x_n
+          FROM cve_cpe c
+          JOIN cve_summary s ON s.id = c.cve_id
+         WHERE c.vendor = ? AND c.product = ? AND c.part = 'a'
+           AND s.pub_year >= ? AND s.cvss31_score >= ?
+           AND s.primary_cwe IS NOT NULL AND s.primary_cwe != ''
+         GROUP BY s.primary_cwe, s.pillar_id, s.pillar_name
+         ORDER BY c DESC LIMIT ?
+    """
+    try:
+        rows = con.execute(sql, (vendor, product, since, min_cvss, top)).fetchall()
+    except sqlite3.Error:
+        return []
+    return [{"cwe": r[0], "pillar": r[2], "count": r[3],
+             "kev": r[4] or 0, "exploit_refs": r[5] or 0,
+             "sample": "hint" if r[3] < 5 else "prior"} for r in rows]
+
+# ── Empirical exploit-risk model ──────────────────────────────────────────────
+# Ported from workspace/Research Bug/tools/exploit_risk.py, whose multipliers
+# were fitted on 408,714 CVEs against the 1,746 CISA KEV entries. The point of
+# carrying it into the hunt is that CVSS alone is a poor guide to what actually
+# gets exploited: the research measured that CVSS>=9.0 misses 64.1% of actively
+# exploited vulnerabilities, because a 9.8 in an unreachable component loses to
+# a 7.5 on an internet-facing VPN.
+BASE_RATE = 0.0045
+_PR_MULT = {"NONE": 1.96, "LOW": 0.91, "HIGH": 0.86}
+_UI_MULT = {"NONE": 1.56, "REQUIRED": 1.27}
+_AC_MULT = {"LOW": 1.49, "HIGH": 1.32}
+_AV_MULT = {"NETWORK": 1.48, "LOCAL": 1.55, "ADJACENT_NETWORK": 0.93, "PHYSICAL": 0.42}
+_EXPLOIT_REF_MULT = 1.85
+_CWE_MULT = {
+    "CWE-843": 11.3, "CWE-288": 5.7, "CWE-502": 4.9, "CWE-78": 4.0,
+    "CWE-693": 3.9, "CWE-306": 3.3, "CWE-94": 2.9, "CWE-59": 2.8,
+    "CWE-77": 2.7, "CWE-416": 2.6, "CWE-787": 2.6, "CWE-287": 2.0,
+    "CWE-22": 2.0, "CWE-79": 0.4,
+}
+_VENDOR_HAZARD = {
+    "synacor": 42.8, "sonicwall": 20.2, "citrix": 16.5, "ivanti": 16.0,
+    "paloaltonetworks": 10.1, "vmware": 7.7, "fortinet": 6.2, "microsoft": 5.3,
+    "dlink": 3.7, "cisco": 3.4, "apple": 2.4, "adobe": 2.3, "google": 1.3,
+    "oracle": 0.9, "linux": 0.3, "ibm": 0.2,
+}
+
+
+def exploit_risk(row: dict) -> dict:
+    """Empirical probability that this CVE is exploited in the wild.
+
+    Input keys mirror cve_summary columns. Returns {pct, tier, reasons} where
+    reasons is the auditable trail — a score nobody can explain is a score
+    nobody should act on.
+    """
+    p = BASE_RATE
+    reasons: list[str] = []
+    pr = (row.get("cvss31_pr") or "").upper()
+    if pr in _PR_MULT:
+        p *= _PR_MULT[pr]
+        if _PR_MULT[pr] > 1.2:
+            reasons.append(f"unauthenticated (PR=NONE {_PR_MULT[pr]:.2f}x)")
+    ui = (row.get("cvss31_ui") or "").upper()
+    if ui in _UI_MULT:
+        p *= _UI_MULT[ui]
+    ac = (row.get("cvss31_ac") or "").upper()
+    if ac in _AC_MULT:
+        p *= _AC_MULT[ac]
+    av = (row.get("cvss31_av") or "").upper()
+    if av in _AV_MULT:
+        p *= _AV_MULT[av]
+        if av == "NETWORK":
+            reasons.append(f"network-reachable ({_AV_MULT[av]:.2f}x)")
+    if row.get("has_exploit_ref"):
+        p *= _EXPLOIT_REF_MULT
+        reasons.append(f"public exploit reference ({_EXPLOIT_REF_MULT:.2f}x)")
+    cwe = (row.get("primary_cwe") or "").upper()
+    if cwe in _CWE_MULT:
+        p *= _CWE_MULT[cwe]
+        if _CWE_MULT[cwe] >= 2.0:
+            reasons.append(f"{cwe} weaponises at {_CWE_MULT[cwe]:.1f}x baseline")
+    vendor = (row.get("vendor") or "").lower()
+    if vendor in _VENDOR_HAZARD:
+        p *= _VENDOR_HAZARD[vendor]
+        if _VENDOR_HAZARD[vendor] >= 3.0:
+            reasons.append(f"{vendor} edge/appliance hazard "
+                           f"{_VENDOR_HAZARD[vendor]:.1f}x")
+
+    pct = round(min(0.98, p) * 100, 2)
+    if row.get("kev"):
+        tier = "KEV"
+    elif pct >= 15:
+        tier = "eminent"
+    elif pct >= 4:
+        tier = "elevated"
+    elif pct >= 1:
+        tier = "moderate"
+    else:
+        tier = "low"
+    return {"pct": pct, "tier": tier, "reasons": reasons}
