diff --git a/tests/test_surface_rank.py b/tests/test_surface_rank.py
new file mode 100644
index 0000000..cb614db
--- /dev/null
+++ b/tests/test_surface_rank.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Stage 2 (surface ranking) of the 5-stage pipeline.
+
+Why this exists: recon hands back hundreds of live URLs and the model picks
+whatever sorts first — normally the apex page, which has no attack surface.
+The ranking must (a) put auth/API/upload-style endpoints above static ones,
+(b) never fail a hunt when recon wrote nothing, and (c) replace a stale
+ranking on a re-run instead of leaving both in working memory.
+
+Standalone (no pytest):  python3 tests/test_surface_rank.py
+"""
+import sys
+from pathlib import Path
+
+BUGHUNTER = Path(__file__).resolve().parent.parent / "bughunter"
+sys.path.insert(0, str(BUGHUNTER))
+
+import agent  # noqa: E402
+
+fails = 0
+
+
+def check(cond, label):
+    global fails
+    print(("  ok   " if cond else "  FAIL ") + label)
+    if not cond:
+        fails += 1
+
+
+def make_recon(tmp: Path, urls: list[str], name: str = "recon") -> Path:
+    # name matters: tests build several recon dirs under the same tmp and a
+    # shared "recon" would silently clobber an earlier case's fixtures.
+    d = tmp / name
+    (d / "live").mkdir(parents=True, exist_ok=True)
+    (d / "live" / "urls.txt").write_text("\n".join(urls) + "\n")
+    return d
+
+
+def main() -> int:
+    global fails
+    fails = 0
+    import tempfile
+
+    with tempfile.TemporaryDirectory() as td:
+        tmp = Path(td)
+
+        print("1. auth/API endpoints outrank the apex page")
+        recon = make_recon(tmp, [
+            "https://example.com/",
+            "https://example.com/static/app.js",
+            "https://example.com/graphql",
+            "https://example.com/api/v1/users",
+            "https://example.com/login",
+        ])
+        ranked = agent.rank_surface(str(recon))
+        urls = [r["url"] for r in ranked]
+        check(len(ranked) == 5, f"returned all 5 URLs ({len(ranked)})")
+        check(urls[0].endswith("/graphql"), f"rank 1 is /graphql (got {urls[0]})")
+        check(any("/login" in u for u in urls[:3]), "/login in top 3")
+        # apex and the static asset both score the baseline 10, so they land
+        # in the bottom two — what matters is neither reaches the top 3.
+        apex = "https://example.com/"
+        check(urls.index(apex) >= 3, f"bare apex not in top 3 (position {urls.index(apex)})")
+        check("/static/app.js" not in urls[:3], "static JS not in top 3")
+
+        print("2. duplicate URLs are deduplicated across source files")
+        recon2 = tmp / "recon2"
+        (recon2 / "urls").mkdir(parents=True)
+        (recon2 / "live").mkdir()
+        shared = "https://example.com/api/v1/items"
+        (recon2 / "live" / "urls.txt").write_text(shared + "\n")
+        (recon2 / "urls" / "all.txt").write_text(shared + "\n" + shared + "\n")
+        ranked2 = agent.rank_surface(str(recon2))
+        check(len(ranked2) == 1, f"deduped to 1 ({len(ranked2)})")
+        check(ranked2[0]["score"] >= 60, f"API URL scored >=60 ({ranked2[0]['score']})")
+
+        print("3. missing/empty recon is a clean empty result, not an error")
+        try:
+            check(agent.rank_surface(str(tmp / "nope")) == [], "missing dir -> []")
+            check(agent.rank_surface("") == [], "empty path -> []")
+            check(agent.rank_surface(None) == [], "None -> []")
+            empty = tmp / "emptyrecon"
+            empty.mkdir()
+            check(agent.rank_surface(str(empty)) == [], "recon dir with no urls -> []")
+        except Exception as exc:  # noqa: BLE001
+            check(False, f"raised {type(exc).__name__}: {exc}")
+
+        print("4. top=N is respected")
+        recon3 = make_recon(tmp, [f"https://example.com/api/v{i}" for i in range(20)],
+                                      name="recon3")
+        check(len(agent.rank_surface(str(recon3), top=5)) == 5, "top=5 returns 5")
+        check(len(agent.rank_surface(str(recon3), top=3)) == 3, "top=3 returns 3")
+
+        print("5. every ranked row carries a reason (model can act on it)")
+        check(all(r.get("why") for r in ranked), "each row has a 'why'")
+        check(all(r["score"] >= 10 for r in ranked), "each row has a numeric score")
+
+        print("6. format_surface_rank renders a numbered block, empty on no data")
+        block = agent.format_surface_rank(ranked)
+        check(block.startswith("[SURFACE RANKING]"), "block has the marker header")
+        check("\n  1. " in block and "\n  5. " in block, "numbered 1..5")
+        check(agent.format_surface_rank([]) == "", "no ranked rows -> empty string")
+
+        print("7. recon dispatch injects the ranking into working memory")
+        mem = agent.HuntMemory(str(tmp / "session.json"))
+        # A scope_checker is mandatory: AutopilotGuard fails CLOSED and would
+        # block run_recon (a network tool) before the ranking ever runs. That
+        # is correct behaviour — this test is about stage 2, so give it a
+        # scope that matches the target rather than disabling the guard.
+        from tools.scope_checker import ScopeChecker
+        d = agent.ToolDispatcher(
+            "example.com", mem,
+            scope_checker=ScopeChecker(domains=["example.com"]),
+            time_budget_hours=2.0,
+        )
+
+        class FakeHunt:
+            @staticmethod
+            def _resolve_recon_dir(domain):
+                return str(recon)
+
+            @staticmethod
+            def run_recon(domain, quick=True, scope_lock=False):
+                return True
+
+        import agent as agent_mod
+        real_h = agent_mod._h
+        agent_mod._h = lambda: FakeHunt
+        try:
+            d.dispatch("run_recon", {"quick": True})
+            wm = mem.working_memory
+            check("[SURFACE RANKING]" in wm, "marker present in working_memory")
+            check("/graphql" in wm, "ranked URL present in working_memory")
+
+            # Re-run must REPLACE, not append a second stale block.
+            d.dispatch("run_recon", {"quick": True})
+            check(mem.working_memory.count("[SURFACE RANKING]") == 1,
+                  "re-rank replaces rather than duplicates")
+            # And the observation given to the model carries it too.
+            check(bool(mem.observation_buf) and
+                  "[SURFACE RANKING]" in mem.observation_buf[-1]["text"],
+                  "ranking also returned to the model in the observation")
+        except Exception as exc:  # noqa: BLE001
+            check(False, f"dispatch raised {type(exc).__name__}: {exc}")
+        finally:
+            agent_mod._h = real_h
+
+    print("RESULT:", "ALL PASS" if fails == 0 else "%d FAILURES" % fails)
+    return fails
+
+
+def test_surface_rank():
+    assert main() == 0
