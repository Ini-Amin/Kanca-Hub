+# ── Stage 2: surface ranking ─────────────────────────────────────────────────
+#
+# Recon returns a firehose (hundreds of live hosts/URLs). Without a rank the
+# model picks the first row it sees — usually an apex page with nothing on it —
+# and spends its whole budget there. These weights put auth/API/upload-style
+# endpoints at the top so step 2 starts on something with an attack surface.
+# Pure scoring over files already on disk: no network, no LLM call, so it
+# cannot burn budget or fail open.
+SURFACE_WEIGHTS = (
+    ("graphql",  90, "GraphQL endpoint — introspection/batching/authz"),
+    ("gql",      85, "GraphQL endpoint — introspection/batching/authz"),
+    ("login",    80, "auth entrypoint — credential/lockout/NoSQLi surface"),
+    ("signin",   80, "auth entrypoint — credential/lockout/NoSQLi surface"),
+    ("oauth",    78, "OAuth flow — redirect_uri/state/consent bugs"),
+    ("sso",      78, "SSO flow — SAML/OIDC assertion handling"),
+    ("admin",    75, "admin surface — usually authorization-gated"),
+    ("upload",   72, "file upload — path traversal/AV bypass/RCE"),
+    ("webhook",  70, "webhook/callback — SSRF by design, high impact"),
+    ("callback", 68, "callback endpoint — SSRF by design, high impact"),
+    ("api/",     65, "API endpoint — IDOR/authz mass-assignment surface"),
+    ("/api",     60, "API endpoint — IDOR/authz mass-assignment surface"),
+    ("token",    55, "token endpoint — issuance/validation flaws"),
+    ("session",  55, "session handling — fixation/rotation flaws"),
+    ("user",     45, "user-scoped path — IDOR candidate"),
+    ("account",  45, "account-scoped path — IDOR candidate"),
+    ("search",   35, "search/input surface — injection candidate"),
+    ("report",   35, "reporting path — access-control candidate"),
+)
+
+
+def rank_surface(recon_dir: str, top: int = 5) -> list[dict]:
+    """Rank live URLs from a recon dir by likely attack value.
+
+    Returns [{"url":..., "score":..., "why":...}, ...] highest first. Reads
+    only artifacts recon already wrote (live/urls.txt, urls/all.txt); an empty
+    or missing dir is a clean empty result, never an error — ranking must not
+    be able to fail a hunt that recon succeeded at.
+    """
+    if not recon_dir or not os.path.isdir(recon_dir):
+        return []
+    sources = [
+        os.path.join(recon_dir, "live", "urls.txt"),
+        os.path.join(recon_dir, "urls", "all.txt"),
+        os.path.join(recon_dir, "all-urls.txt"),
+    ]
+    seen: set[str] = set()
+    scored: list[dict] = []
+    for src in sources:
+        if not os.path.isfile(src):
+            continue
+        try:
+            with open(src, encoding="utf-8", errors="replace") as fh:
+                raw = fh.read()
+        except OSError:
+            continue
+        for line in raw.splitlines():
+            url = line.strip().split()[0] if line.strip() else ""
+            if not url.startswith("http") or url in seen:
+                continue
+            seen.add(url)
+            low = url.lower()
+            score, why = 10, "live URL"
+            for token, weight, reason in SURFACE_WEIGHTS:
+                if token in low and weight > score:
+                    score, why = weight, reason
+            scored.append({"url": url, "score": score, "why": why})
+    scored.sort(key=lambda r: (-r["score"], r["url"]))
+    return scored[:top]
+
+
+def format_surface_rank(ranked: list[dict]) -> str:
+    """Render rank_surface() output as the block injected into working memory."""
+    if not ranked:
+        return ""
+    lines = ["[SURFACE RANKING] High-value endpoints for this target (ranked):"]
+    for i, r in enumerate(ranked, 1):
+        lines.append(f"  {i}. {r['url']}  (score {r['score']}) — {r['why']}")
+    lines.append("  Start with rank 1-2 before touching unranked hosts.")
+    return "\n".join(lines)
+
 
