+    if not os.path.isdir(js_dir) or not os.listdir(js_dir):
+        log("info", f"No JS bundles captured for {domain} — nothing to scan.")
+        return False
+    log("info", f"Scanning {len(os.listdir(js_dir))} JS bundle(s) for secrets...")
+    child_env = os.environ.copy()
