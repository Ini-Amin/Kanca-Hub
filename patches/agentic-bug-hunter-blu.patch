@@ -0,0 +1,566 @@
+#!/usr/bin/env python3
+"""cve_intel.py — turn recon fingerprints into CVE hypotheses, from the local DB.
+
+WHY THIS EXISTS
+---------------
+The 494 MB `~/.config/auto-freecf/cve.db` (390,221 CVEs, FTS5) was only ever
+read by the *gate* in `abh_hunt._cve_describe()`, and only to REJECT a finding
+that claimed an already-published CVE. So the hunt ran blind while the single
+largest piece of intel on the box sat unused, and the gate paid the cost of
+opening it only after a finding had already been claimed.
+
+This module flips the direction: fingerprints observed during recon (nginx,
+Apache, Spring, PHP, a framework banner) become CVE candidates *before* any
+scanning, ranked by CVSS and recency. The output is a HYPOTHESIS LIST, not a
+finding — a CVE in the database says a bug exists in that product version, not
+that this host runs the vulnerable version. That distinction is why every row
+carries `verify` instructions instead of a severity claim.
+
+The version gate is the important part. "nginx is installed" matches thousands
+of CVEs; "nginx 1.18.0" matches the handful that could actually apply. When a
+version is unknown the row is marked `version-unknown` and ranked lower, never
+promoted to a finding.
+
+Usage:
+    python3 cve_intel.py --recon <recon_dir> [--min-cvss 7] [--since 2019]
+    python3 cve_intel.py --product nginx --version 1.18.0
+    python3 cve_intel.py --keyword "apache sling" [--json]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sqlite3
+import sys
+from pathlib import Path
+
+DEFAULT_DB = Path(os.environ.get(
+    "BOUNTY_CVE_DB",
+    str(Path.home() / ".config" / "auto-freecf" / "cve.db")))
+
+# The richer source. cve_research.db keeps what the legacy build discarded:
+# 2.7M vulnerable-configuration rows (258k with real version ranges), CISA KEV,
+# exploit references, and the CWE View-1000 pillar rollup. When present it is
+# used FIRST because it can answer "is this version inside a published
+# vulnerable range", which is evidence, instead of "does any advisory mention
+# this product", which is a reading list.
+RESEARCH_DB = Path(os.environ.get(
+    "BOUNTY_CVE_RESEARCH_DB",
+    str(Path.home() / "workspace" / "Research Bug" / "cve_research.db")))
+
+# Fingerprints that httpx/tech-detect emits but that are not products with a
+# CVE feed. Keeping them out is what stops "HSTS" from matching a CVE whose
+# description happens to contain the string.
+NOISE = {
+    "hsts", "http/2", "http/3", "cloudflare", "cloudflare bot management",
+    "amazon", "amazon cloudfront", "akamai", "fastly", "google", "nginx?",
+}
+
+# Where a fingerprint came from decides whether a CVE about it is testable
+# HERE. This distinction is the difference between a useful lead and a wasted
+# step: "the target runs nginx 1.31.1" is a hypothesis, "the target embeds
+# Google Analytics" is a fact about a third party that the target cannot patch.
+# Measured on bitso.com: 33 fingerprints, and without this split the top hits
+# were Amazon Athena, MinIO, and a WordPress plugin -- none of which the target
+# runs. The agent would have burned its step budget on them.
+SERVER_SIDE = {
+    "nginx", "apache", "apache http server", "httpd", "iis", "caddy", "envoy",
+    "haproxy", "traefik", "tomcat", "jetty", "wildfly", "jboss", "weblogic",
+    "websphere", "gunicorn", "uvicorn", "puma", "unicorn", "passenger",
+    "php", "php-fpm", "asp.net", "node.js", "deno", "bun", "express",
+    "koa", "fastify", "next.js", "nuxt", "gatsby", "remix", "django",
+    "flask", "fastapi", "rails", "laravel", "symfony", "spring", "spring boot",
+    "struts", "grails", "wordpress", "drupal", "joomla", "magento", "shopify",
+    "ghost", "typo3", "concrete cms", "gitlab", "jenkins", "grafana", "kibana",
+    "elasticsearch", "logstash", "prometheus", "rabbitmq", "redis", "memcached",
+    "postgresql", "mysql", "mariadb", "mongodb", "minio", "consul", "vault",
+    "keycloak", "sonarqube", "jira", "confluence", "bitbucket", "nexus",
+    "artifactory", "openresty", "liteSpeed", "lighttpd", "varnish", "squid",
+}
+
+# Client-side libraries: a CVE here is real, but it is only reachable through
+# the page (DOM XSS, prototype pollution), so it ranks below a server product
+# and above a third-party service the target does not control.
+CLIENT_LIBS = {
+    "jquery", "jquery migrate", "jquery ui", "react", "react-dom", "angular",
+    "angularjs", "vue", "svelte", "ember", "backbone", "bootstrap", "lodash",
+    "underscore", "moment", "moment.js", "handlebars", "mustache", "dojo",
+    "d3", "three.js", "axios", "socket.io", "dompurify", "tinymce", "ckeditor",
+}
+
+# Third-party services the target merely *uses* (CDN, analytics, support chat,
+# hosting). The target cannot fix these and testing them is out of scope, so a
+# CVE row about them is noise for this target.
+THIRD_PARTY = {
+    "amazon s3", "amazon web services", "amazon elb", "google cloud",
+    "google cloud cdn", "google analytics", "google tag manager",
+    "google font api", "hubspot", "hubspot cms hub", "atlassian statuspage",
+    "linkedin ads", "recaptcha", "freshchat", "vercel", "render", "substack",
+    "readme", "cdnjs", "bowser", "cloudflare browser insights", "sentry",
+    "segment", "intercom", "zendesk", "stripe", "paypal", "braintree",
+    "facebook pixel", "hotjar", "mixpanel", "amplitude", "new relic",
+    "datadog", "pingdom", "onetrust", "cookiebot", "typekit", "font awesome",
+    "unpkg", "jsdelivr", "swifttype", "optimizely", "algolia",
+}
+
+
+def classify(product: str) -> str:
+    """server | client | thirdparty | unknown — decides how much a CVE matters."""
+    p = _norm(product)
+    if p in SERVER_SIDE:
+        return "server"
+    if p in CLIENT_LIBS:
+        return "client"
+    if p in THIRD_PARTY:
+        return "thirdparty"
+    # "amazon s3" style: a known provider prefix means the target is a consumer.
+    if any(p.startswith(x) for x in ("amazon ", "google ", "microsoft azure",
+                                     "cloudflare ", "akamai ", "facebook ")):
+        return "thirdparty"
+    return "unknown"
+
+
+def _norm(s: str) -> str:
+    return re.sub(r"[^a-z0-9.+ -]", "", (s or "").lower()).strip()
+
+
+def parse_tech(recon_dir: Path) -> list[dict]:
+    """Product fingerprints from a recon directory.
+
+    Reads both shapes recon_engine.sh produces:
+      * live/httpx_full.txt — `https://host [200] [1234] [Nginx,Cloudflare]`
+      * technologies.txt    — `nginx=1.18.0` / `PHP/7.4`
+    Version is carried when present because it is the difference between a
+    useful candidate and 1,500 irrelevant rows.
+    """
+    found: dict[str, dict] = {}
+
+    def add(product: str, version: str = "", source: str = "") -> None:
+        p = _norm(product)
+        if not p or p in NOISE or len(p) < 2:
+            return
+        rec = found.setdefault(p, {"product": p, "versions": set(), "sources": set()})
+        if version:
+            rec["versions"].add(version)
+        if source:
+            rec["sources"].add(source)
+
+    httpx = recon_dir / "live" / "httpx_full.txt"
+    if httpx.is_file():
+        for line in httpx.read_text(errors="replace").splitlines():
+            # The tech block is the last [...] group and is comma-separated.
+            m = re.findall(r"\[([^\[\]]*)\]", line)
+            if not m:
+                continue
+            tech = m[-1]
+            if not re.search(r"[A-Za-z]", tech) or re.fullmatch(r"[\d,\s]+", tech):
+                continue
+            for item in tech.split(","):
+                item = item.strip()
+                if not item:
+                    continue
+                vm = re.match(r"^(.+?)[/: ]\s*v?(\d[\w.]*)$", item)
+                if vm:
+                    add(vm.group(1), vm.group(2), "httpx")
+                else:
+                    add(item, "", "httpx")
+
+    for name in ("technologies.txt", f"{recon_dir.name}-technologies.txt"):
+        p = recon_dir / name
+        if not p.is_file():
+            continue
+        for line in p.read_text(errors="replace").splitlines():
+            line = line.strip()
+            if not line:
+                continue
+            m = (re.match(r"(?i)^([a-z][\w.+-]+)\s*[=:/]\s*v?(\d[\w.]*)", line)
+                 or re.match(r"(?i)^([a-z][\w.+-]+)\s+v?(\d[\w.]*)$", line))
+            if m:
+                add(m.group(1), m.group(2), "technologies")
+            else:
+                add(line.split()[0], "", "technologies")
+
+    return sorted(found.values(), key=lambda r: (not r["versions"], r["product"]))
+
+
+def _connect(db: Path) -> sqlite3.Connection | None:
+    if not db.is_file():
+        return None
+    try:
+        return sqlite3.connect(f"file:{db}?mode=ro", uri=True)
+    except sqlite3.Error:
+        return None
+
+
+def search(con: sqlite3.Connection, product: str, version: str = "",
+           min_cvss: float = 7.0, since: int = 2019, limit: int = 6) -> list[dict]:
+    """CVEs for one product, version-matched when a version is known.
+
+    Version matching is deliberately conservative: a CVE row whose description
+    contains the exact version string ("1.18.0") ranks above one that only
+    names the product. We do NOT attempt to evaluate version ranges — CVE
+    descriptions are prose, not a constraint language, and pretending otherwise
+    would manufacture precision the data does not have.
+    """
+    prod = _norm(product)
+    if not prod:
+        return []
+    where = ["year >= ?", "cvss31 >= ?",
+             "(vendors LIKE ? OR description LIKE ?)"]
+    args: list = [since, min_cvss, f"%{prod}%", f"%{prod}%"]
+    if version:
+        # Product AND version in the description is the only reliable pairing
+        # in this schema; anything looser matches every release of the product.
+        where.append("description LIKE ?")
+        args.append(f"%{version}%")
+    # Over-fetch and rank in Python. A bare `description LIKE '%nginx%'` puts
+    # "Roxy-WI manages Nginx" and "cpp-httplib" at CVSS 10 above real nginx
+    # CVEs, because the product name appears as an incidental mention. The
+    # vendor column and the description's opening words are what separate
+    # "this CVE is about nginx" from "this CVE mentions nginx".
+    sql = (f"SELECT id, year, severity, cvss31, vendors, description "
+           f"FROM cve WHERE {' AND '.join(where)} "
+           f"ORDER BY cvss31 DESC, year DESC LIMIT ?")
+    # Over-fetch generously: the SQL window is ordered by CVSS alone, so a
+    # product whose top scores are all taken by same-prefix products
+    # ("Nginx UI") would push its own rows out of a small window entirely.
+    # 200 rows is ~0.15s on this DB and guarantees the ranking below sees a
+    # representative spread instead of only the first page of 9.8s.
+    try:
+        rows = con.execute(sql, args + [max(200, limit * 20)]).fetchall()
+    except sqlite3.Error as exc:
+        print(f"cve_intel: query failed for {product}: {exc}", file=sys.stderr)
+        return []
+
+    word = re.compile(rf"\b{re.escape(prod)}\b", re.I)
+    out = []
+    for cid, year, sev, score, vendors, desc in rows:
+        desc = " ".join((desc or "").split())
+        vendor_set = {v.strip().lower() for v in (vendors or "").split(",") if v.strip()}
+        # "subject" = this CVE is ABOUT the product, not merely near its name.
+        # The description's opening words are the only reliable signal in this
+        # schema: "Nginx UI is a web UI for the Nginx web server" is about
+        # Nginx UI, while "A flaw in nginx 1.18.0 allows..." is about nginx.
+        # Both still get returned — the agent needs the list, and a wrong
+        # exclusion here is a silent false negative, which is worse than one
+        # row the agent has to dismiss. `subject` is what lets it tell them
+        # apart without re-reading every summary.
+        subject = bool(word.match(desc)) or prod in vendor_set
+        if not (subject or word.search(desc)):
+            continue
+        # "Nginx UI ...", "Apache Traffic Server ...", "Docker Desktop ..." --
+        # a different product whose name merely BEGINS with ours. It is not
+        # excluded (excluding would be a silent false negative if the feed
+        # ever uses the compound spelling for the real thing), but it sorts
+        # below rows that are actually about the observed product. Without
+        # this, a version-less "nginx" fingerprint returned four Nginx-UI CVEs
+        # and zero real nginx CVEs, which is worse than useless.
+        # Case matters here and re.I would break it: the product is matched
+        # case-insensitively, but the FOLLOWING word must genuinely be
+        # capitalised ("Nginx UI", "Nginx NJS") rather than a lowercase
+        # sentence word ("nginx through 1.20") or a version ("nginx 1.18.0").
+        # Both spellings appear: "Nginx UI" and "Nginx-UI".
+        _m = re.match(rf"(?i)^{re.escape(prod)}\s*[-/]?\s*(\S+)", desc)
+        _tok = _m.group(1) if _m else ""
+        compound = bool(_tok) and _tok[0].isupper() and not _tok[0].isdigit()
+        exact = bool(version) and version in desc
+        out.append({
+            "id": cid,
+            "cvss": score,
+            "severity": sev,
+            "year": year,
+            "vendors": vendors,
+            "summary": desc[:220],
+            "version_match": "exact" if exact else "product-only",
+            "subject": subject,
+            "compound_name": compound,
+        })
+    # exact version > about this product > merely mentions it > CVSS.
+    # compound_name last so a real nginx CVE at 7.5 outranks Nginx-UI at 9.8.
+    out.sort(key=lambda c: (c["version_match"] != "exact",
+                            not c["subject"],
+                            c["compound_name"],
+                            -(c["cvss"] or 0)))
+    # de-duplicate on id in case a row satisfies both LIKE clauses twice
+    seen, uniq = set(), []
+    for c in out:
+        if c["id"] in seen:
+            continue
+        seen.add(c["id"])
+        uniq.append(c)
+    return uniq[:limit]
+
+
+def cwe_patterns(con: sqlite3.Connection, product: str, since: int = 2017,
+                 min_cvss: float = 7.0, top: int = 6) -> list[dict]:
+    """Which bug classes this product historically suffers from.
+
+    This is the answer to "can the DB suggest where to look" rather than "which
+    CVE id do I replay". A product whose high-severity history is dominated by
+    CWE-22 (path traversal) is worth fuzzing for traversal even when no
+    single advisory matches the observed version — the advisory list is a
+    sample, the distribution is the prior.
+
+    Counts are over the same rows `search()` uses, so the two never disagree
+    about what "the product's CVEs" means. Small samples are returned as-is and
+    labelled: n<5 is a hint, not a prior.
+    """
+    prod = _norm(product)
+    if not prod:
+        return []
+    sql = """SELECT cwes, COUNT(*) FROM cve
+             WHERE year >= ? AND cvss31 >= ?
+               AND (vendors LIKE ? OR description LIKE ?)
+               AND cwes IS NOT NULL AND cwes != ''
+             GROUP BY cwes ORDER BY 2 DESC LIMIT ?"""
+    try:
+        rows = con.execute(sql, (since, min_cvss, f"%{prod}%", f"%{prod}%",
+                                 top * 3)).fetchall()
+    except sqlite3.Error:
+        return []
+    out = []
+    for cwes, n in rows:
+        for cwe in str(cwes).replace(";", ",").split(","):
+            cwe = cwe.strip().upper()
+            if cwe.startswith("CWE-"):
+                out.append({"cwe": cwe, "count": n})
+    # A CVE may carry several CWEs; merge the duplicates that split created.
+    merged: dict[str, int] = {}
+    for r in out:
+        merged[r["cwe"]] = merged.get(r["cwe"], 0) + r["count"]
+    ranked = sorted(merged.items(), key=lambda kv: -kv[1])[:top]
+    return [{"cwe": c, "count": n, "sample": "hint" if n < 5 else "prior"}
+            for c, n in ranked]
+
+
+def _load_matcher():
+    """cve_match lives beside this file; import without requiring a package."""
+    import importlib.util
+    here = Path(__file__).resolve().parent
+    spec = importlib.util.spec_from_file_location("cve_match", here / "cve_match.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def intel_for(recon_dir: Path, db: Path = DEFAULT_DB, min_cvss: float = 7.0,
+              since: int = 2019, per_product: int = 6,
+              research_db: Path = RESEARCH_DB) -> dict:
+    """Full pass: fingerprints -> ranked CVE hypotheses.
+
+    Two sources, in order of evidential strength:
+
+    1. `cve_research.db` — CPE version ranges. A hit means the observed version
+       is inside a published vulnerable range. That is evidence.
+    2. `cve.db` — description search. A hit means an advisory mentions the
+       product. That is a reading list.
+
+    Both are labelled in the output (`range-match` vs `version-unmatched`) and
+    range hits always sort first. Merging them silently would let a prose match
+    masquerade as a version match, which is the one thing this tool must never
+    do — it would turn "nginx appears in this CVE's text" into "this host is
+    vulnerable".
+    """
+    con = _connect(db)
+    research = None
+    matcher = None
+    try:
+        matcher = _load_matcher()
+        research = matcher.open_db(research_db)
+    except Exception:  # noqa: BLE001 - optional source, never fatal
+        research = None
+
+    if con is None and research is None:
+        return {"error": f"no CVE database found (looked for {db} and {research_db})",
+                "products": [], "candidates": []}
+
+    try:
+        products = parse_tech(recon_dir)
+        candidates: list[dict] = []
+        pattern_map: dict[str, list[dict]] = {}
+        range_hits_total = 0
+        for p in products:
+            versions = sorted(p["versions"])
+            hits: list[dict] = []
+
+            # 1) Exact range match from the research DB (only when exactly one
+            # version was observed — two versions means we do not know which one
+            # is live, and guessing would produce a confident wrong answer).
+            if research is not None and matcher is not None and len(versions) == 1:
+                try:
+                    vp = matcher.resolve_product(p["product"], research)
+                    if vp:
+                        hits = matcher.match_version(
+                            research, vp[0], vp[1], versions[0],
+                            min_cvss=min_cvss, since=since, limit=per_product)
+                        range_hits_total += len(hits)
+                        for h in hits:
+                            h["product"] = p["product"]
+                            h["observed_versions"] = versions
+                            h["scope"] = classify(p["product"])
+                            h["verify"] = (
+                                f"{h['id']} lists {p['product']} {versions[0]} as "
+                                f"vulnerable ({h['match']}). Confirm the version is "
+                                f"actually served by a live endpoint from recon, then "
+                                f"reproduce on an authorised asset.")
+                except Exception:  # noqa: BLE001
+                    hits = []
+
+            # 2) Description search in the legacy DB as a fallback / supplement.
+            if not hits and con is not None:
+                hits = search(con, p["product"],
+                              versions[0] if len(versions) == 1 else "",
+                              min_cvss=min_cvss, since=since, limit=per_product)
+                if not hits and versions:
+                    # A known version that no description names is the common
+                    # case: advisories say "prior to 1.25.5", not "1.31.1".
+                    # Falling back to product-level rows keeps the lead alive
+                    # and marks it version-unmatched, which tells the agent to
+                    # compare the observed version against the advisory range
+                    # itself. Returning nothing would silently hide every CVE
+                    # for that product.
+                    hits = search(con, p["product"], "", min_cvss=min_cvss,
+                                  since=since, limit=per_product)
+                    for h in hits:
+                        h["version_match"] = "version-unmatched"
+
+            # 3) Bug-class prior. Prefer the research DB's View-1000 pillar
+            #    rollup (it says "Improper Neutralization", i.e. where to fuzz)
+            #    and fall back to raw CWE ids from the legacy table.
+            pats: list[dict] = []
+            if research is not None and matcher is not None:
+                try:
+                    vp2 = matcher.resolve_product(p["product"], research)
+                    if vp2:
+                        pats = matcher.patterns(research, vp2[0], vp2[1],
+                                                since=since, min_cvss=min_cvss)
+                except Exception:  # noqa: BLE001
+                    pats = []
+            if not pats and con is not None:
+                pats = cwe_patterns(con, p["product"], since=since, min_cvss=min_cvss)
+            pattern_map[p["product"]] = pats
+
+            for h in hits:
+                h["product"] = p["product"]
+                h["observed_versions"] = versions
+                h["scope"] = classify(p["product"])
+                h["cwe_history"] = [x["cwe"] for x in pats[:3]]
+                if not h.get("verify"):
+                    h["verify"] = (
+                        f"Confirm {p['product']}"
+                        + (f" {versions[0]}" if versions else "")
+                        + f" is actually running, then reproduce {h['id']} against a "
+                          f"live endpoint from recon. A DB row is a hypothesis; it is "
+                          f"not evidence this host is vulnerable.")
+                candidates.append(h)
+
+        # Order: testable-here first (server > client > unknown), then
+        # version-matched, then CVSS. Third-party rows are dropped entirely --
+        # they are CVEs about software the target does not run.
+        rank = {"server": 0, "client": 1, "unknown": 2}
+        # Evidence strength, strongest first. "range" means the observed version
+        # is inside a published vulnerable range; "exact"/"version-unmatched"
+        # are description matches and must never outrank it, or the agent reads
+        # a prose hit as if the version had been confirmed.
+        evidence = {"range": 0, "exact": 1, "version-unmatched": 2, "product-only": 3}
+        dropped = sum(1 for c in candidates if c["scope"] == "thirdparty")
+        candidates = [c for c in candidates if c["scope"] != "thirdparty"]
+        candidates.sort(key=lambda c: (evidence.get(c["version_match"], 3),
+                                       rank.get(c["scope"], 2),
+                                       not c.get("kev"),
+                                       -(c["cvss"] or 0)))
+        return {
+            "db": str(db),
+            "products": [{"product": p["product"], "versions": sorted(p["versions"]),
+                          "scope": classify(p["product"])}
+                         for p in products],
+            "candidates": candidates,
+            "dropped_thirdparty": dropped,
+            "patterns": {k: v for k, v in pattern_map.items()
+                         if v and classify(k) in ("server", "client")},
+            "sources": {
+                "research_db": str(research_db) if research is not None else None,
+                "legacy_db": str(db) if con is not None else None,
+            },
+            "range_matches": range_hits_total,
+        }
+    finally:
+        con.close()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--recon", help="recon directory for the target")
+    ap.add_argument("--product")
+    ap.add_argument("--version", default="")
+    ap.add_argument("--keyword")
+    ap.add_argument("--min-cvss", type=float, default=7.0)
+    ap.add_argument("--since", type=int, default=2019)
+    ap.add_argument("--limit", type=int, default=6)
+    ap.add_argument("--db", default=str(DEFAULT_DB))
+    ap.add_argument("--json", action="store_true")
+    a = ap.parse_args()
+
+    db = Path(a.db)
+    con = _connect(db)
+    if con is None:
+        print(f"cve.db not found at {db}", file=sys.stderr)
+        return 2
+
+    try:
+        if a.recon:
+            res = intel_for(Path(a.recon), db, a.min_cvss, a.since, a.limit)
+            if a.json:
+                print(json.dumps(res, indent=2))
+                return 0
+            src = res.get("sources") or {}
+            print(f"sources: research_db={'yes' if src.get('research_db') else 'no'} "
+                  f"legacy_db={'yes' if src.get('legacy_db') else 'no'} "
+                  f"| range matches: {res.get('range_matches', 0)}")
+            print(f"fingerprints: {len(res['products'])}")
+            for p in res["products"]:
+                v = ", ".join(p["versions"]) or "version unknown"
+                print(f"  {p['product']:28} {v}")
+            print(f"\ncandidates: {len(res['candidates'])}")
+            for c in res["candidates"]:
+                flag = "?" if c.get("compound_name") else ("K" if c.get("kev") else " ")
+                why = c.get("match") or " ".join((c.get("summary") or "").split())[:70]
+                risk = c.get("risk_pct")
+                rtxt = f"{risk:5.1f}%" if risk is not None else "     "
+                print(f" {flag}{c['id']:18} cvss={str(c['cvss']):<4} risk={rtxt} "
+                      f"{c['product']:18} [{c['version_match']}] {why[:70]}")
+            if any(c.get("kev") for c in res["candidates"]):
+                print("  (K = CISA Known Exploited Vulnerability — prioritise these)")
+            if any(c.get("compound_name") for c in res["candidates"]):
+                print("  (? = different product whose name starts with the observed "
+                      "one, e.g. 'Nginx UI' vs 'nginx' — verify before testing)")
+            if res.get("patterns"):
+                print("\nhistorical bug classes (guides WHAT to test, not a finding):")
+                for prod, pats in res["patterns"].items():
+                    if pats:
+                        print(f"  {prod:24} " + ", ".join(
+                            f"{p['cwe']}x{p['count']}" for p in pats))
+            return 0
+
+        if a.product or a.keyword:
+            hits = search(con, a.product or a.keyword, a.version, a.min_cvss, a.since, a.limit)
+            if a.json:
+                print(json.dumps(hits, indent=2))
+                return 0
+            for h in hits:
+                print(f"{h['id']:18} {h['cvss']:<5} {h['severity']:8} "
+                      f"{' '.join(h['summary'].split())[:110]}")
+            if not hits:
+                print("no CVE matched (try a lower --min-cvss or a broader keyword)")
+            return 0
+
+        ap.print_help()
+        return 1
+    finally:
+        con.close()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
