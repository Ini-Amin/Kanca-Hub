+def _implemented_tool_names() -> set[str]:
+    """Tool names that actually resolve to a callable in tools/hunt.py.
+
+    `TOOLS` advertises 18 tools; 11 of them have no implementation in
+    hunt.py at all (run_secret_hunt, run_cors_check, run_api_fuzz, ...). The
+    loop sent the full list to the model anyway, so the model picked a tool
+    that raised `module 'hunt' has no attribute ...` on every call, retried it,
+    and burned the session. Measured on blu 2026-10-21: 3 steps executed, 2 of
+    them errors on run_secret_hunt.
+
+    Resolving against the module is the only honest check — a hardcoded list
+    drifts the moment someone adds a function. Tools implemented INSIDE
+    agent.py (finish, read_recon_summary, run_drost_tool, ...) are added by
+    the caller.
+    """
+    try:
+        return {n for n in dir(_h()) if n.startswith("run_") and callable(getattr(_h(), n))}
+    except Exception:  # noqa: BLE001 - a broken hunt.py must not hide every tool
+        return set()
+
+
 TOOL_NAMES = {t["function"]["name"] for t in TOOLS}
 
+# Tools handled by ToolDispatcher itself rather than by hunt.py.
+_LOCAL_TOOLS = {"finish", "read_recon_summary", "read_findings_summary",
+                "update_working_memory", "run_drost_tool"}
+
+
+def available_tools() -> list[dict]:
+    """The subset of TOOLS the model can actually call.
+
+    Advertising an unimplemented tool is worse than omitting it: the model
+    spends a step discovering the failure, then often retries it, and the
+    trace records a tool error that looks like a target problem.
+    """
+    impl = _implemented_tool_names()
+    return [t for t in TOOLS
+            if t["function"]["name"] in impl or t["function"]["name"] in _LOCAL_TOOLS]
+
+
+# Resolved once per process: the model is offered only tools that exist.
+_TOOLS_FOR_MODEL = available_tools()
+
 
