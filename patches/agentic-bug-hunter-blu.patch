+def _model_fallbacks() -> list[str]:
+    """Models to try after the primary fails, in order.
+
+    Comma-separated via BOUNTY_MODEL_FALLBACKS, defaulting to the two models
+    known healthy behind 9router on blu. Kept as a function (not a module
+    constant) so an operator can change it per run without re-importing.
+    """
